        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-tide btn-sm" id="cropImageBtn">Apply Crop</button>
        </div>
      </div>
    </div>
