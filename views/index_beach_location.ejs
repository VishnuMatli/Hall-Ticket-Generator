  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

  <script>
    // --- 1. STUDENT FETCH LOGIC ---
    const fetchForm = document.getElementById("fetchForm");
    const rollFetch = document.getElementById("roll_number_fetch");
    const dobFetch = document.getElementById("dob_fetch");

    fetchForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = fetchForm.querySelector("button[type='submit']");
      const originalHTML = btn.innerHTML;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Searching...';
      btn.disabled = true;

      const roll = rollFetch.value.trim();
      const dob = dobFetch.value;

      if (!roll || !dob) {
        alert("Credentials Missing");
        btn.innerHTML = originalHTML;
        btn.disabled = false;
        return;
      }

      try {
        const res = await fetch("/api/get-student", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ roll_number: roll, dob })
        });

        const data = await res.json();
        if (!res.ok) {
          alert(data.error || "Student not found.");
        } else {
          ['roll_number', 'name', 'father_name', 'mother_name', 'dob', 'department', 'year', 'semester', 'section', 'mobile', 'gender', 'regulation', 'caste'].forEach(id => {
             if(document.getElementById(id)) document.getElementById(id).value = data[id] || "";
          });

          if (data.photo_base64) {
            document.getElementById("photoPreview").src = data.photo_base64;
            document.getElementById("photoPreview").style.display = 'block';
            document.getElementById("emptyIcon").style.display = 'none';
          }
          
          document.getElementById("hallForm").scrollIntoView({ behavior: 'smooth' });
        }
      } catch (err) {
        console.error(err);
        alert("Connection error.");
      } finally {
        btn.innerHTML = originalHTML;
        btn.disabled = false;
      }
    });

    // --- 2. CURRICULUM / BACKLOG SYNC LOGIC ---
    const loadSubjectsBtn = document.getElementById("loadSubjectsBtn");
    const subjectsContainer = document.getElementById("subjectsContainer");
    
    loadSubjectsBtn.addEventListener("click", async () => {
      const dept = document.getElementById("department").value;
      const year = document.getElementById("year").value;
      const sem = document.getElementById("semester").value;
      const reg = document.getElementById("regulation").value;
      const examType = document.getElementById("exam_type").value;
      const roll = document.getElementById("roll_number").value;

      const isSupp = examType === 'Supplementary';

      if (!dept || !reg || (!isSupp && (!year || !sem))) {
        alert("Please select all Academic Parameters.");
        return;
      }

      subjectsContainer.innerHTML = `<div class="text-center py-4 text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Loading curriculum...</div>`;

      try {
        const url = `/api/subjects?department=${encodeURIComponent(dept)}&year=${encodeURIComponent(year)}&semester=${encodeURIComponent(sem)}&regulation=${encodeURIComponent(reg)}&exam_type=${encodeURIComponent(examType)}&roll_number=${encodeURIComponent(roll)}`;
        const res = await fetch(url);
        const subs = await res.json();

        if (!Array.isArray(subs) || subs.length === 0) {
          const msg = examType === 'Supplementary' 
            ? `<div class="text-center text-warning small"><i class="fas fa-exclamation-triangle me-2"></i>No backlog subjects configured. Please contact your administrator.</div>`
            : `<div class="text-center text-muted small">No subjects found.</div>`;
          subjectsContainer.innerHTML = msg;
          return;
        }

        let html = '<div class="row g-2">';
        subs.forEach((s) => {
          const value = `${s.subject_code}||${s.subject_name}`;
          html += `
            <div class="col-md-6">
              <div class="subject-card d-flex align-items-center">
                <input class="form-check-input mt-0 me-3" type="checkbox" name="subjects" value="${value}" id="sub_${s.id}" checked>
                <label class="form-check-label lh-sm w-100" for="sub_${s.id}" style="cursor: pointer;">
                  <span class="d-block fw-bold text-dark small mb-1">${s.subject_code}</span>
                  <span class="text-secondary small d-block">${s.subject_name}</span>
                </label>
              </div>
            </div>`;
        });
        html += '</div>';
        subjectsContainer.innerHTML = html;

      } catch (err) {
        console.error(err);
        subjectsContainer.innerHTML = `<div class="text-danger text-center small">Sync failed.</div>`;
      }
    });

    // --- 3. PAYMENT INTEGRATION (SANDBOX) ---
    const payBtn = document.getElementById("payBtn");
    const paymentStatus = document.getElementById("paymentStatus");
    let paymentVerified = false;
    let currentOrderId = null;

    payBtn.addEventListener("click", async () => {
      const roll = document.getElementById("roll_number").value.trim();
      const mode = document.getElementById("mode").value;
      const examType = document.getElementById("exam_type").value;
      const examMonth = document.getElementById("exam_month").value;
      const examYear = document.getElementById("exam_year").value;
      const semester = document.getElementById("semester").value;

      if (!roll || !examType || !examMonth || !examYear || !mode || !semester) {
        alert("Fill roll number, mode, semester and exam details before payment.");
        return;
      }

      payBtn.disabled = true;
      paymentStatus.textContent = "Creating payment order...";

      try {
        const resp = await fetch("/api/create-order", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            roll_number: roll,
            exam_type: examType,
            exam_month: examMonth,
            exam_year: examYear,
            mode: mode,
            semester: semester,
          }),
        });
        if (!resp.ok) {
          paymentStatus.textContent = "Payment initialization failed. Please try again.";
          return;
        }
        const data = await resp.json();
        if (data.error) {
          paymentStatus.textContent = data.error || "Payment initialization failed.";
          return;
        }

        currentOrderId = data.orderId || null;

        const options = {
          key: data.keyId || "",
          amount: data.amount,
          currency: "INR",
          name: "MITS Exam Fee (Sandbox)",
          description: `${examType} / ${examMonth} ${examYear}`,
          order_id: data.orderId,
          handler: async function (response) {
            paymentStatus.textContent = "Verifying payment...";
            try {
              const verify = await fetch("/api/verify-payment", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  roll_number: roll,
                  exam_type: examType,
                  exam_month: examMonth,
                  exam_year: examYear,
                  razorpay_order_id: response.razorpay_order_id,
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_signature: response.razorpay_signature,
                }),
              });
              const vdata = await verify.json();
              if (vdata.ok) {
                paymentVerified = true;
                paymentStatus.textContent =
                  "Payment successful. Awaiting admin approval for hallticket release.";
              } else {
                paymentStatus.textContent = vdata.error || "Payment verification failed.";
              }
            } catch (err) {
              console.error(err);
              paymentStatus.textContent = "Payment verification error.";
            }
          },
          modal: {
            ondismiss: function () {
              // Mark the latest created order for this student as cancelled
              if (currentOrderId) {
                fetch("/api/payment-cancel", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    roll_number: roll,
                    exam_type: examType,
                    exam_month: examMonth,
                    exam_year: examYear,
                    razorpay_order_id: currentOrderId,
                  }),
                }).catch((e) => console.error("cancel update failed", e));
              }
              paymentStatus.textContent = "Payment cancelled by user.";
            },
          },
          theme: { color: "#2c7a7b" },
        };

        const rzp = new Razorpay(options);
        rzp.open();
      } catch (err) {
        console.error(err);
        paymentStatus.textContent = "Payment initialization error.";
      } finally {
        payBtn.disabled = false;
      }
    });

    // --- 3. PHOTO CROP LOGIC ---
    const photoInput = document.getElementById('photoInput');
    const imageToCrop = document.getElementById('imageToCrop');
    const cropModalEl = document.getElementById('cropModal');
    const cropModal = new bootstrap.Modal(cropModalEl);
    let cropper;

    photoInput.addEventListener('change', function (e) {
      const files = e.target.files;
      if (files && files.length > 0) {
        const file = files[0];
        const reader = new FileReader();
        reader.onload = function (e) {
          photoInput.value = ''; 
          imageToCrop.src = reader.result;
          cropModal.show();
        };
        reader.readAsDataURL(file);
      }
    });

    cropModalEl.addEventListener('shown.bs.modal', function () {
      cropper = new Cropper(imageToCrop, {
        aspectRatio: 3 / 4,
        viewMode: 1,
        autoCropArea: 1,
        background: false,
      });
    });

    cropModalEl.addEventListener('hidden.bs.modal', function () {
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
    });

    document.getElementById('cropImageBtn').addEventListener('click', function () {
      if (!cropper) return;
      
      const canvas = cropper.getCroppedCanvas({ width: 300, height: 400 });
      
      canvas.toBlob(function (blob) {
        const newFile = new File([blob], "cropped.jpg", { type: "image/jpeg" });
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(newFile);
        photoInput.files = dataTransfer.files;

        const previewUrl = URL.createObjectURL(blob);
        document.getElementById("photoPreview").src = previewUrl;
        document.getElementById("photoPreview").style.display = 'block';
        document.getElementById("emptyIcon").style.display = 'none';
        
        cropModal.hide();
      }, 'image/jpeg');
    });
// Ask browser for GPS location
let clientLocation = "Unknown";

if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
        (pos) => {
            clientLocation = `${pos.coords.latitude},${pos.coords.longitude}`;
        },
        () => {
            clientLocation = "Permission Denied";
        }
    );
}

// Attach to hall ticket submission
document.getElementById("hallForm").addEventListener("submit", () => {
    const hidden = document.createElement("input");
    hidden.type = "hidden";
    hidden.name = "device_gps";
    hidden.value = clientLocation;
    document.getElementById("hallForm").appendChild(hidden);
});

  </script>
</body>
</html>