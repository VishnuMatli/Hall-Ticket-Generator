<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MITS | Coastal Portal</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">

  <style>
    :root {
      /* Palette: Coastal Serenity */
      --sand-light: #fdfbf7;      /* Cream base */
      --sand-mid: #f3eee6;        /* Warm beige */
      --sand-dark: #e5e0d8;       /* Wet sand */
      
      /* Accents */
      --ocean-teal: #2c7a7b;      /* Deep Teal */
      --ocean-light: #81e6d9;     /* Seafoam */
      --driftwood: #4a5568;       /* Grey-Brown text */
      
      /* Surfaces */
      --glass-milk: rgba(255, 255, 255, 0.65); /* Half-white glass */
      --glass-border: rgba(255, 255, 255, 0.9);
      
      /* Typography */
      --font-serif: 'Playfair Display', serif;
      --font-sans: 'Lato', sans-serif;
      
      --radius-soft: 24px;
      --radius-sm: 12px;
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--sand-light);
      /* Subtle sunset gradient */
      background: linear-gradient(120deg, var(--sand-light) 0%, var(--sand-dark) 100%);
      color: var(--driftwood);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* Texture Overlay: Organic Grain */
    body::before {
      content: "";
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: -1;
    }

    .main-container {
      max-width: 1080px;
      margin: 0 auto;
      flex: 1;
      padding: 4rem 1.5rem;
    }

    /* --- MILKY GLASS CARDS --- */
    .beach-card {
      background: var(--glass-milk);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-soft);
      box-shadow: 
        0 20px 40px -10px rgba(74, 85, 104, 0.1), /* Soft shadow */
        inset 0 0 20px rgba(255,255,255,0.5); /* Inner light */
      margin-bottom: 2.5rem;
      transition: transform 0.4s ease;
      overflow: hidden;
    }

    .beach-card:hover {
      transform: translateY(-5px);
    }

    .card-header-beach {
      padding: 2rem 2.5rem 1rem 2.5rem;
      border-bottom: 1px solid rgba(74, 85, 104, 0.05);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .beach-title {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 1.3rem;
      color: var(--ocean-teal);
      font-style: italic;
    }

    .card-body-beach { padding: 2.5rem; }

    /* --- ORGANIC INPUTS --- */
    .form-label {
      font-family: var(--font-sans);
      font-size: 0.8rem;
      letter-spacing: 0.05em;
      font-weight: 700;
      color: var(--driftwood);
      text-transform: uppercase;
      margin-bottom: 0.6rem;
    }

    .form-control, .form-select {
      background-color: rgba(255, 255, 255, 0.5); /* Very light, half-white */
      border: 1px solid transparent; /* No border initially */
      box-shadow: 0 2px 5px rgba(0,0,0,0.03);
      color: var(--driftwood);
      border-radius: var(--radius-sm);
      padding: 14px 18px;
      font-size: 1rem;
      transition: all 0.3s ease;
    }

    .form-control:focus, .form-select:focus {
      background-color: #fff;
      box-shadow: 0 4px 15px rgba(44, 122, 123, 0.1);
      border-color: var(--ocean-teal);
      outline: none;
    }

    input[readonly] {
      background-color: rgba(230, 225, 215, 0.4) !important;
      color: #718096 !important;
      cursor: default;
      box-shadow: none;
    }

    /* --- BUTTONS: Sea Glass & Driftwood --- */
    .btn-tide {
      background: var(--ocean-teal);
      color: #fff;
      border: none;
      padding: 12px 24px;
      border-radius: 50px;
      font-weight: 700;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 15px rgba(44, 122, 123, 0.3);
      transition: all 0.3s ease;
    }

    .btn-tide:hover {
      background: #236c6d;
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(44, 122, 123, 0.4);
    }

    .btn-shell {
      background: transparent;
      border: 1px solid var(--ocean-teal);
      color: var(--ocean-teal);
      padding: 8px 16px;
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 700;
      transition: all 0.2s;
    }
    
    .btn-shell:hover {
      background: rgba(44, 122, 123, 0.05);
    }

    .btn-sunset {
      width: 100%;
      background: linear-gradient(135deg, var(--ocean-teal) 0%, #285e61 100%);
      color: #fff;
      border: none;
      padding: 18px;
      font-family: var(--font-serif);
      font-size: 1.1rem;
      font-weight: 700;
      border-radius: var(--radius-sm);
      margin-top: 1.5rem;
      box-shadow: 0 10px 25px -5px rgba(44, 122, 123, 0.4);
      transition: all 0.4s ease;
      position: relative;
      overflow: hidden;
    }
    
    /* Ripple Effect on Hover */
    .btn-sunset::after {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(rgba(255,255,255,0.2), transparent);
      transform: translateY(-100%);
      transition: transform 0.4s;
    }
    .btn-sunset:hover::after { transform: translateY(0); }
    .btn-sunset:hover { transform: translateY(-3px); }


    /* --- HEADER --- */
    .app-header {
      text-align: center;
      padding-top: 2rem;
      margin-bottom: 3rem;
    }

    .logo-shadow {
      filter: drop-shadow(0 4px 6px rgba(160, 140, 120, 0.4));
    }

    .univ-title {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 2.2rem;
      color: var(--driftwood);
      margin-top: 0.5rem;
      text-shadow: 2px 2px 0px rgba(255,255,255,0.5);
    }
    
    .tagline {
      font-family: var(--font-sans);
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--ocean-teal);
      font-size: 0.8rem;
      font-weight: 700;
      background: rgba(255,255,255,0.4);
      padding: 5px 15px;
      border-radius: 50px;
      display: inline-block;
    }

    /* --- PHOTO & EXTRAS --- */
    .photo-frame {
      background: #fff;
      padding: 1rem;
      border-radius: var(--radius-sm);
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
      transform: rotate(2deg); /* Playful Polaroid style */
      transition: 0.3s;
      margin-bottom: 1.5rem;
    }
    .photo-frame:hover { transform: rotate(0deg) scale(1.02); }

    .transparency-sand {
      background-color: #f3eee6;
      background-image: radial-gradient(#d1ccc0 1px, transparent 1px);
      background-size: 10px 10px;
      height: 180px;
      display: flex; justify-content: center; align-items: center;
      border-radius: 4px;
      overflow: hidden;
    }

    #photoPreview { object-fit: cover; max-height: 100%; display: none; }

    /* Curriculum */
    #subjectsContainer {
      background: rgba(255,255,255,0.4);
      border: 1px dashed var(--ocean-teal);
      border-radius: var(--radius-sm);
      padding: 1.5rem;
    }

    .subject-card {
      background: #fff;
      padding: 15px;
      border-radius: 12px;
      border: 1px solid rgba(0,0,0,0.03);
      transition: 0.2s;
      box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }
    .subject-card:hover {
      box-shadow: 0 5px 15px rgba(0,0,0,0.05);
      border-color: var(--ocean-teal);
    }

    .doc-bundle {
      background: rgba(44, 122, 123, 0.05);
      border-radius: var(--radius-sm);
      padding: 1.5rem;
      border: 1px solid rgba(44, 122, 123, 0.1);
    }
    .doc-bundle li {
      margin-bottom: 8px;
      display: flex; align-items: center; gap: 10px;
      font-weight: 600;
      color: var(--driftwood);
    }
    .doc-bundle i { color: var(--ocean-teal); }

    .form-check-input:checked {
      background-color: var(--ocean-teal);
      border-color: var(--ocean-teal);
    }

    /* Footer */
    .app-footer {
      border-top: 1px solid rgba(0,0,0,0.05);
      padding-top: 2rem;
      text-align: center;
      margin-top: auto;
      color: #718096;
    }

    /* Modal */
    .modal-content {
      background: #fdfbf7;
      border-radius: var(--radius-soft);
      border: none;
    }
    .modal-header { border-bottom: 1px solid rgba(0,0,0,0.05); }
    .modal-footer { border-top: 1px solid rgba(0,0,0,0.05); }

  </style>
</head>

<body>

  <header class="app-header">
    <div class="container">
      <img src="https://i.ibb.co/G34J1pBD/MITS.png" alt="Logo" class="logo-shadow mb-3" height="70">
      <div>
        <span class="tagline">Examination Cell - Hall Tickets</span>
        <h1 class="univ-title">Madanapalle Institute of<br>Technology &amp; Science</h1>
        <h3 class="beach-title">Deemed to be University</h3>
      </div>
    </div>
  </header>

  <div class="container main-container">

    <div class="beach-card">
      <div class="card-header-beach">
        <span class="beach-title">01. Identification</span>
      </div>
      <div class="card-body-beach">
        <form id="fetchForm" class="row g-4 align-items-end">
          <div class="col-md-5">
            <label class="form-label">Roll Number</label>
            <input type="text" class="form-control" id="roll_number_fetch" placeholder="e.g. 24695A4006" required style="letter-spacing: 1px; text-transform: uppercase;">
          </div>
          <div class="col-md-5">
            <label class="form-label">Date of Birth</label>
            <input type="date" class="form-control" id="dob_fetch" required>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-tide w-100">
              Fetch
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="beach-card">
      <div class="card-header-beach">
        <span class="beach-title">02. Configuration</span>
      </div>
      <div class="card-body-beach">

        <form id="hallForm" action="/generate-halltkt" method="POST" enctype="multipart/form-data" target="_blank">
          <input type="hidden" name="caste" id="caste">
          <input type="hidden" name="mobile" id="mobile">
          <div class="row g-5">

            <div class="col-lg-8">
              
              <div class="mb-4 pb-2 border-bottom">
                 <h6 class="text-secondary" style="font-family: var(--font-serif); font-style: italic;">Profile Information</h6>
              </div>
              
              <div class="row g-3 mb-5">
                <div class="col-md-6">
                  <label class="form-label">Roll Number</label>
                  <input type="text" name="roll_number" id="roll_number" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Student Name</label>
                  <input type="text" name="name" id="name" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Father's Name</label>
                  <input type="text" name="father_name" id="father_name" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Mother's Name</label>
                  <input type="text" name="mother_name" id="mother_name" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Date of Birth</label>
                  <input type="date" name="dob" id="dob" class="form-control" readonly>
                </div>
              </div>

              <div class="mb-4 pb-2 border-bottom">
                 <h6 class="text-secondary" style="font-family: var(--font-serif); font-style: italic;">Academic Details</h6>
              </div>

              <div class="row g-3 mb-5">
                <div class="col-md-4">
                  <label class="form-label">Mode</label>
                  <select name="mode" id="mode" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="Autonomous">Autonomous</option>
                    <option value="University">University</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Department</label>
                  <select name="department" id="department" class="form-select">
                    <option value="">Select...</option>
                    <option value="Networks">Networks</option>
                    <option value="AI & ML">AI & ML</option>
                    <option value="AI">AI</option>
                    <option value="Data Science">Data Science</option>
                    <option value="Cyber Security">Cyber Security</option>
                    <option value="Civil">Civil</option>
                    <option value="EEE">EEE</option>
                    <option value="ECE">ECE</option>
                    <option value="Mechanical">Mechanical</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Regulation</label>
                  <select name="regulation" id="regulation" class="form-select" required>
                    <option value="">Select...</option>
