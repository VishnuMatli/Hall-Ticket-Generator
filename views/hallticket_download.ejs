<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MITS | Hallticket Download</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    :root {
      --sand-light: #fdfbf7;
      --sand-mid: #f3eee6;
      --sand-dark: #e5e0d8;
      --ocean-teal: #2c7a7b;
      --ocean-light: #81e6d9;
      --driftwood: #4a5568;
      --glass-milk: rgba(255, 255, 255, 0.65);
      --glass-border: rgba(255, 255, 255, 0.9);
      --font-serif: 'Playfair Display', serif;
      --font-sans: 'Lato', sans-serif;
      --radius-soft: 24px;
      --radius-sm: 12px;
    }

    body {
      font-family: var(--font-sans);
      background: linear-gradient(120deg, var(--sand-light) 0%, var(--sand-dark) 100%);
      color: var(--driftwood);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: -1;
    }

    .main-container {
      max-width: 960px;
      margin: 0 auto;
      padding: 3.5rem 1.5rem;
      flex: 1;
    }

    .app-header {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .univ-title {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 2rem;
      color: var(--driftwood);
      text-shadow: 2px 2px 0px rgba(255,255,255,0.5);
    }

    .tagline {
      font-family: var(--font-sans);
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--ocean-teal);
      font-size: 0.8rem;
      font-weight: 700;
      background: rgba(255,255,255,0.4);
      padding: 5px 15px;
      border-radius: 50px;
      display: inline-block;
    }

    .beach-card {
      background: var(--glass-milk);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-soft);
      box-shadow: 0 20px 40px -10px rgba(74, 85, 104, 0.1), inset 0 0 20px rgba(255,255,255,0.5);
      overflow: hidden;
    }

    .card-header-beach {
      padding: 1.5rem 2rem 1rem 2rem;
      border-bottom: 1px solid rgba(74, 85, 104, 0.05);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-body-beach {
      padding: 2rem;
    }

    .form-label {
      font-family: var(--font-sans);
      font-size: 0.8rem;
      letter-spacing: 0.05em;
      font-weight: 700;
      color: var(--driftwood);
      text-transform: uppercase;
      margin-bottom: 0.6rem;
    }

    .form-control {
      background-color: rgba(255, 255, 255, 0.5);
      border: 1px solid transparent;
      box-shadow: 0 2px 5px rgba(0,0,0,0.03);
      border-radius: var(--radius-sm);
      padding: 12px 16px;
      font-size: 0.95rem;
    }

    .form-control:focus {
      background-color: #fff;
      box-shadow: 0 4px 15px rgba(44, 122, 123, 0.1);
      border-color: var(--ocean-teal);
      outline: none;
    }

    .btn-tide {
      background: var(--ocean-teal);
      color: #fff;
      border: none;
      padding: 10px 22px;
      border-radius: 999px;
      font-weight: 700;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 15px rgba(44, 122, 123, 0.3);
      transition: all 0.3s ease;
    }

    .btn-tide:hover {
      background: #236c6d;
      transform: translateY(-1px);
      box-shadow: 0 8px 20px rgba(44, 122, 123, 0.4);
    }

    .app-footer {
      text-align: center;
      padding-bottom: 2rem;
      color: rgba(74, 85, 104, 0.8);
      font-size: 0.8rem;
    }
  </style>
</head>
<body>
  <div class="main-container">
    <header class="app-header">
      <div class="tagline mb-2">MITS Examination Cell</div>
      <h1 class="univ-title mb-1">Hallticket Download</h1>
      <p class="small text-muted mb-0">Secure access to approved halltickets after fee payment & admin verification.</p>
    </header>

    <div class="beach-card mb-4">
      <div class="card-header-beach">
        <div>
          <h5 class="mb-0" style="font-family: var(--font-serif);">Check Hallticket Status</h5>
          <small class="text-muted">Use the same details as on the main portal.</small>
        </div>
        <a href="/" class="btn btn-sm btn-outline-secondary rounded-pill"><i class="bi bi-arrow-left me-1"></i> Back to Portal</a>
      </div>
      <div class="card-body-beach">
        <form class="row g-3 mb-3" id="statusForm">
          <div class="col-12 col-md-4">
            <label class="form-label small">Roll Number</label>
            <input type="text" class="form-control" id="dl_roll" required>
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label small">Date of Birth</label>
            <input type="date" class="form-control" id="dl_dob" required>
          </div>
          <div class="col-12 col-md-3 d-flex align-items-end">
            <button class="btn-tide w-100" type="submit"><i class="bi bi-search me-2"></i>Check Status</button>
          </div>
        </form>

        <div id="statusArea" class="mb-3"></div>
        <div id="paymentsArea"></div>
      </div>
    </div>

    <footer class="app-footer">
      <p class="mb-0">MITS Offshore Coastal Portal &mdash; Hallticket Module</p>
    </footer>
  </div>

  <script>
    const form = document.getElementById('statusForm');
    const statusArea = document.getElementById('statusArea');
    const paymentsArea = document.getElementById('paymentsArea');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const roll = document.getElementById('dl_roll').value.trim();
      const dob = document.getElementById('dl_dob').value;
      if (!roll || !dob) return;

      statusArea.innerHTML = '<div class="text-info small">Loading student & payment status...</div>';
      paymentsArea.innerHTML = '';

      try {
        const stuRes = await fetch('/api/get-student', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ roll_number: roll, dob })
        });
        if (!stuRes.ok) {
          statusArea.innerHTML = '<div class="text-danger small">Student not found. Check roll and DOB.</div>';
          return;
        }
        const student = await stuRes.json();
        statusArea.innerHTML = `<div class="card border-0 shadow-sm mb-3" style="border-radius:16px;"><div class="card-body"><h5 class="card-title mb-1" style="font-family: var(--font-serif);">${student.name}</h5><div class="small text-muted">${student.roll_number} &mdash; ${student.department} / ${student.semester}</div></div></div>`;

        const payRes = await fetch(`/api/payment-status?roll_number=${encodeURIComponent(roll)}`);
        const data = await payRes.json();
        if (!Array.isArray(data) || !data.length) {
          paymentsArea.innerHTML = '<div class="text-warning small">No payments found for this student.</div>';
          return;
        }

        let html = '<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Exam</th><th>Amount</th><th>Status</th><th>Approval</th><th>Action</th></tr></thead><tbody>';
        data.forEach(p => {
          const semLabel = student.semester ? ` (Sem ${student.semester})` : '';
          const exam = `${p.exam_type} - ${p.exam_month} ${p.exam_year}${semLabel}`;
          const amt = (p.amount || 0) / 100.0;
          const canDownload = p.status === 'paid' && p.approval_status === 'approved';
          html += `<tr>
            <td>${exam}</td>
            <td>₹ ${amt.toFixed(2)}</td>
            <td>${p.status}</td>
            <td>${p.approval_status}</td>
            <td>` + (canDownload ? `<form method="POST" action="/generate-halltkt" target="_blank">
                  <input type="hidden" name="mode" value="download-only">
              <input type="hidden" name="payment_id" value="${p.payment_id}">
                  <input type="hidden" name="roll_number" value="${student.roll_number}">
                  <input type="hidden" name="name" value="${student.name}">
                  <input type="hidden" name="father_name" value="${student.father_name || ''}">
                  <input type="hidden" name="mother_name" value="${student.mother_name || ''}">
                  <input type="hidden" name="caste" value="${student.caste || ''}">
                  <input type="hidden" name="dob" value="${student.dob}">
                  <input type="hidden" name="department" value="${student.department}">
                  <input type="hidden" name="year" value="${student.year}">
                  <input type="hidden" name="semester" value="${student.semester}">
                  <input type="hidden" name="section" value="${student.section || ''}">
                  <input type="hidden" name="mobile" value="${student.mobile || ''}">
                  <input type="hidden" name="gender" value="${student.gender || ''}">
                  <input type="hidden" name="exam_type" value="${p.exam_type}">
                  <input type="hidden" name="exam_month" value="${p.exam_month}">
                  <input type="hidden" name="exam_year" value="${p.exam_year}">
                  <input type="hidden" name="regulation" value="${student.regulation}">
                  <button class="btn btn-sm btn-outline-info rounded-pill"><i class="bi bi-file-earmark-arrow-down me-1"></i>Download</button>
                </form>` : '<span class="small text-muted">Not yet approved</span>') + `</td>
          </tr>`;
        });
        html += '</tbody></table></div>';
        paymentsArea.innerHTML = html;
      } catch (err) {
        console.error(err);
        statusArea.innerHTML = '<div class="text-danger small">Error loading data. Please try again later.</div>';
      }
    });
  </script>
</body>
</html>
