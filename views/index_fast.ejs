<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MITS | Race Logic Portal</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,400;0,600;0,700;1,400&family=Racing+Sans+One&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">

  <style>
    :root {
      /* Palette: Street Racer */
      --asphalt-dark: #0d0d0d;
      --carbon-base: #151515;
      
      /* Accents */
      --nos-blue: #00e5ff;
      --redline: #ff003c;
      --chrome: #e0e0e0;
      
      /* UI Elements */
      --glass-panel: rgba(21, 21, 21, 0.85);
      --border-steel: #333;
      
      /* Typography */
      --font-speed: 'Racing Sans One', cursive;
      --font-tech: 'Exo 2', sans-serif;
    }

    body {
      font-family: var(--font-tech);
      background-color: var(--asphalt-dark);
      color: var(--chrome);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      position: relative;
    }

    /* --- BACKGROUND: Street at Night --- */
    body::before {
      content: '';
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: 
        radial-gradient(circle at 10% 20%, rgba(0, 229, 255, 0.15) 0%, transparent 40%),
        radial-gradient(circle at 90% 80%, rgba(255, 0, 60, 0.1) 0%, transparent 40%),
        linear-gradient(0deg, #050505 0%, #1a1a1a 100%);
      z-index: -2;
    }

    /* Speed Lines Overlay */
    body::after {
      content: '';
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: repeating-linear-gradient(
        90deg,
        transparent,
        transparent 50px,
        rgba(255, 255, 255, 0.03) 50px,
        rgba(255, 255, 255, 0.03) 51px
      );
      z-index: -1;
      pointer-events: none;
    }

    .main-container {
      max-width: 1150px;
      margin: 0 auto;
      flex: 1;
      padding: 3rem 1.5rem;
    }

    /* --- CARBON FIBER CARDS --- */
    .racer-card {
      background-color: var(--carbon-base);
      /* CSS Carbon Fiber Pattern */
      background-image: 
        linear-gradient(27deg, #111 5px, transparent 5px),
        linear-gradient(207deg, #111 5px, transparent 5px),
        linear-gradient(27deg, #222 5px, transparent 5px),
        linear-gradient(207deg, #222 5px, transparent 5px);
      background-size: 10px 10px;
      background-position: 0 0, 10px 0, 10px -10px, 0px 10px;
      
      border: 1px solid var(--border-steel);
      border-radius: 4px; /* Sharp corners */
      margin-bottom: 2.5rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.8);
      position: relative;
      overflow: hidden;
    }

    /* Roll Cage Border Effect */
    .racer-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 4px; height: 100%;
      background: var(--nos-blue);
      box-shadow: 0 0 15px var(--nos-blue);
    }

    .card-header-race {
      padding: 1.5rem 2rem;
      background: rgba(0,0,0,0.8);
      border-bottom: 2px solid var(--border-steel);
      display: flex;
      justify-content: space-between;
      align-items: center;
      transform: skewX(-10deg); /* The speed skew */
      margin-left: -10px;
      width: 105%;
    }

    .card-title-text {
      font-family: var(--font-speed);
      text-transform: uppercase;
      font-size: 1.4rem;
      color: #fff;
      transform: skewX(10deg); /* Unskew text */
      text-shadow: 2px 2px 0px var(--redline);
    }
    
    .card-body-race {
      padding: 2.5rem;
      background: rgba(10, 10, 10, 0.9); /* Dim the carbon fiber for text readability */
    }

    /* --- DASHBOARD INPUTS --- */
    .form-label {
      font-family: var(--font-speed);
      color: var(--nos-blue);
      text-transform: uppercase;
      font-size: 0.9rem;
      margin-bottom: 5px;
      letter-spacing: 1px;
    }

    .form-control, .form-select {
      background-color: #000 !important;
      border: 1px solid #444 !important;
      border-left: 3px solid #666 !important;
      color: #fff !important;
      border-radius: 0; /* Boxy */
      padding: 12px 15px;
      font-family: 'Exo 2', sans-serif;
      font-weight: 600;
      transition: all 0.2s;
    }

    .form-control:focus, .form-select:focus {
      border-color: var(--nos-blue) !important;
      border-left-color: var(--nos-blue) !important;
      box-shadow: 0 0 15px rgba(0, 229, 255, 0.3) !important;
      background-color: #080808 !important;
      transform: scale(1.01);
    }

    input[readonly] {
      background-color: #1a1a1a !important;
      border-color: #333 !important;
      color: #777 !important;
      font-style: italic;
    }
    
    .form-select option { background: #000; color: #fff; }

    /* --- NITROUS BUTTONS --- */
    .btn-search {
      background: transparent;
      border: 2px solid var(--nos-blue);
      color: var(--nos-blue);
      font-family: var(--font-speed);
      text-transform: uppercase;
      font-size: 1.1rem;
      padding: 10px 20px;
      transform: skewX(-10deg);
      transition: all 0.2s;
    }
    
    .btn-search:hover {
      background: var(--nos-blue);
      color: #000;
      box-shadow: 0 0 20px var(--nos-blue);
    }

    /* The Main Launch Button */
    .btn-launch {
      width: 100%;
      background: linear-gradient(90deg, #d32f2f, #b71c1c); /* Red Engine Button */
      border: none;
      color: white;
      font-family: var(--font-speed);
      font-size: 1.5rem;
      text-transform: uppercase;
      padding: 18px;
      clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
      margin-top: 1.5rem;
      letter-spacing: 2px;
      position: relative;
      overflow: hidden;
      transition: all 0.3s;
      border-bottom: 4px solid #7f0000;
    }
    
    /* Revving Animation */
    @keyframes revving {
      0% { transform: translateX(0); }
      25% { transform: translateX(-2px); }
      50% { transform: translateX(2px); }
      75% { transform: translateX(-1px); }
      100% { transform: translateX(0); }
    }

    .btn-launch:hover {
      background: linear-gradient(90deg, var(--redline), #ff1744);
      box-shadow: 0 0 30px rgba(255, 0, 60, 0.6);
      border-bottom: 4px solid #d32f2f;
      animation: revving 0.2s linear infinite; /* Vibrate/Rev effect */
    }

    /* --- HEADER --- */
    .app-header {
      text-align: center;
      margin-bottom: 3rem;
      padding-top: 2rem;
    }
    
    .header-badge {
      display: inline-block;
      background: var(--redline);
      color: #fff;
      font-family: var(--font-speed);
      padding: 5px 15px;
      transform: skewX(-15deg);
      border: 2px solid #fff;
      margin-bottom: 15px;
      box-shadow: 0 0 15px var(--redline);
    }
    
    .header-badge span { display: block; transform: skewX(15deg); }

    .univ-title {
      font-family: var(--font-speed);
      font-size: 2.5rem;
      color: #fff;
      text-transform: uppercase;
      font-style: italic;
      background: linear-gradient(to bottom, #fff 0%, #aaa 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0px 2px 0px #000);
    }

    /* --- EXTRAS --- */
    .photo-frame {
      border: 2px solid var(--border-steel);
      background: #000;
      padding: 5px;
      position: relative;
    }
    
    /* Crosshairs on photo */
    .photo-frame::after {
      content: '+';
      position: absolute;
      top: 10px; right: 10px;
      color: var(--nos-blue);
      font-size: 20px;
      font-family: monospace;
    }
    
    .transparency-grid {
      background-image: 
        repeating-linear-gradient(45deg, #222 25%, transparent 25%, transparent 75%, #222 75%, #222),
        repeating-linear-gradient(45deg, #222 25%, #111 25%, #111 75%, #222 75%, #222);
      background-position: 0 0, 10px 10px;
      background-size: 20px 20px;
      min-height: 200px;
      display: flex; justify-content: center; align-items: center;
      border: 1px solid #333;
    }

    #subjectsContainer {
      background: #050505;
      border: 1px solid var(--nos-blue);
      padding: 15px;
      position: relative;
    }
    
    #subjectsContainer::before {
      content: 'ECU_DATA_STREAM';
      position: absolute;
      top: -10px; right: 10px;
      background: #000;
      color: var(--nos-blue);
      font-size: 0.7rem;
      padding: 0 5px;
      font-family: monospace;
    }

    .subject-check {
      background: #111;
      border: 1px solid #333;
      padding: 10px;
      margin-bottom: 10px;
      transition: 0.2s;
    }
    .subject-check:hover {
      border-color: var(--nos-blue);
      background: rgba(0, 229, 255, 0.1);
    }
    
    .form-check-input:checked {
      background-color: var(--nos-blue);
      border-color: var(--nos-blue);
      box-shadow: 0 0 10px var(--nos-blue);
    }

    .app-footer {
      border-top: 2px solid var(--border-steel);
      padding-top: 2rem;
      margin-top: 3rem;
      text-align: center;
      color: #666;
      font-family: var(--font-tech);
      font-size: 0.8rem;
    }

    /* Modal */
    .modal-content {
      background: #111;
      border: 1px solid var(--redline);
      color: #fff;
    }
    .modal-header { border-bottom: 1px solid #333; }
    .modal-footer { border-top: 1px solid #333; }
    .btn-close { filter: invert(1); }

  </style>
</head>

<body>

  <header class="app-header">
    <div class="container">
      <div class="header-badge">
        <span>EXAM CONTROL DIVISION</span>
      </div>
      <h1 class="univ-title">MITS SPEED PORTAL</h1>
      <p style="color: var(--nos-blue); letter-spacing: 2px; font-weight: 600; text-transform: uppercase;">// Secure Connection // Nitro Enabled</p>
    </div>
  </header>

  <div class="container main-container">

    <div class="racer-card">
      <div class="card-header-race">
        <span class="card-title-text">01 // DRIVER ID</span>
        <i class="bi bi-person-fill text-white fs-4" style="transform: skewX(10deg);"></i>
      </div>
      <div class="card-body-race">
        <form id="fetchForm" class="row g-4 align-items-end">
          <div class="col-md-5">
            <label class="form-label">Roll No</label>
            <input type="text" class="form-control" id="roll_number_fetch" placeholder="e.g. 24695A4006" required style="font-family: monospace; letter-spacing: 2px; text-transform: uppercase; color: var(--nos-blue) !important;">
          </div>
          <div class="col-md-5">
            <label class="form-label">Genesis (DOB)</label>
            <input type="date" class="form-control" id="dob_fetch" required>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-search w-100">
              <span style="display:inline-block; transform: skewX(10deg);">SCAN</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="racer-card">
      <div class="card-header-race">
        <span class="card-title-text">02 // TUNING & CONFIG</span>
        <i class="bi bi-speedometer2 text-white fs-4" style="transform: skewX(10deg);"></i>
      </div>
      <div class="card-body-race">

        <form id="hallForm" action="/generate-halltkt" method="POST" enctype="multipart/form-data" target="_blank">
          <div class="row g-5">

            <div class="col-lg-8">
              
              <div class="mb-4 pb-2 border-bottom border-secondary">
                <span style="color: #fff; font-family: var(--font-speed); font-size: 1.2rem;">DRIVER STATS</span>
              </div>
              
              <div class="row g-3 mb-5">
                <div class="col-md-6">
                  <label class="form-label">Roll Number</label>
                  <input type="text" name="roll_number" id="roll_number" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Full Name</label>
                  <input type="text" name="name" id="name" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Crew / Guardian</label>
                  <input type="text" name="father_name" id="father_name" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">DOB</label>
                  <input type="date" name="dob" id="dob" class="form-control" readonly>
                </div>
              </div>

              <div class="mb-4 pb-2 border-bottom border-secondary">
                <span style="color: #fff; font-family: var(--font-speed); font-size: 1.2rem;">TRACK SPECS (ACADEMIC)</span>
              </div>

              <div class="row g-3 mb-5">
                <div class="col-md-4">
                  <label class="form-label">Mode</label>
                  <select name="mode" id="mode" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="Autonomous">Autonomous</option>
                    <option value="University">University</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Class (Dept)</label>
                  <select name="department" id="department" class="form-select">
                    <option value="">Select...</option>
                    <option value="Networks">Networks</option>
                    <option value="AI & ML">AI & ML</option>
                    <option value="AI">AI</option>
                    <option value="Data Science">Data Science</option>
                    <option value="Cyber Security">Cyber Security</option>
                    <option value="Civil">Civil</option>
                    <option value="EEE">EEE</option>
                    <option value="ECE">ECE</option>
                    <option value="Mechanical">Mechanical</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Reg</label>
                  <select name="regulation" id="regulation" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="R23">R23</option>
                    <option value="R20">R20</option>
                    <option value="R19">R19</option>
                    <option value="R18">R18</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Year</label>
                  <select name="year" id="year" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="1">I Year</option>
                    <option value="2">II Year</option>
                    <option value="3">III Year</option>
                    <option value="4">IV Year</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Semester</label>
                  <select name="semester" id="semester" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="I-I">I-I</option>
                    <option value="I-II">I-II</option>
                    <option value="II-I">II-I</option>
                    <option value="II-II">II-II</option>
                    <option value="III-I">III-I</option>
                    <option value="III-II">III-II</option>
                    <option value="IV-I">IV-I</option>
                    <option value="IV-II">IV-II</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Section</label>
                  <input type="text" name="section" id="section" class="form-control" placeholder="A/B/C">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Mobile</label>
                  <input type="text" name="mobile" id="mobile" class="form-control">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Gender</label>
                  <select name="gender" id="gender" class="form-select">
                    <option value="">Select...</option>
                    <option>Male</option>
                    <option>Female</option>
                    <option>Other</option>
                  </select>
                </div>
              </div>

              <div class="p-4 mb-5" style="background: rgba(255, 0, 60, 0.05); border: 1px solid var(--redline);">
                 <div class="row g-3">
                    <div class="col-md-4">
                      <label class="form-label text-white">Exam Type</label>
                      <select name="exam_type" id="exam_type" class="form-select" required>
                        <option value="Regular">Regular</option>
                        <option value="Supplementary">Supplementary</option>
                      </select>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label text-white">Month</label>
                      <select name="exam_month" id="exam_month" class="form-select" required>
                        <option value="">Select...</option>
                        <option>January</option>
                        <option>February</option>
                        <option>March</option>
                        <option>April</option>
                        <option>May</option>
                        <option>June</option>
                        <option>July</option>
                        <option>August</option>
                        <option>September</option>
                        <option>October</option>
                        <option>November</option>
                        <option>December</option>
                      </select>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label text-white">Year</label>
                      <select name="exam_year" id="exam_year" class="form-select" required>
                        <option value="">Select...</option>
                        <option>2025</option>
                        <option>2026</option>
                        <option>2027</option>
                      </select>
                    </div>
                 </div>
              </div>

              <div class="d-flex justify-content-between align-items-center mb-3">
                 <label class="form-label text-white mb-0">LOADOUT (SUBJECTS)</label>
                <button type="button" id="loadSubjectsBtn" class="btn btn-sm btn-outline-light" style="border-radius: 0; font-family: var(--font-speed);">
                   <i class="bi bi-arrow-repeat text-danger"></i> REFRESH MAP
                </button>
              </div>

              <div id="subjectsContainer">
                <div class="text-center text-secondary small py-4" style="font-family: monospace;">
                  [WAITING FOR INPUT]
                </div>
              </div>
            </div>

            <div class="col-lg-4">
              <div class="mb-3">
                 <label class="form-label">DRIVER PHOTO</label>
              </div>

              <div class="photo-frame mb-4">
                <div class="transparency-grid mb-3">
                   <div id="emptyIcon" class="text-muted"><i class="bi bi-person-fill fs-1 opacity-25"></i></div>
                   <img id="photoPreview" class="img-fluid" style="display: none;">
                </div>

                <input type="file" name="photo" id="photoInput" class="form-control form-control-sm mb-2" accept="image/*" style="font-size: 0.8rem;">
              </div>

              <div class="p-3 mb-4" style="background: #111; border-left: 3px solid var(--nos-blue);">
                <h6 class="fw-bold mb-3 text-white" style="font-family: var(--font-speed);">CHECKLIST</h6>
                <ul class="list-unstyled small mb-0" style="color: #bbb; font-family: monospace;">
                  <li class="mb-2"><i class="bi bi-check-square-fill me-2 text-primary"></i> Application Form</li>
                  <li class="mb-2"><i class="bi bi-check-square-fill me-2 text-primary"></i> Hall Ticket (User)</li>
                  <li><i class="bi bi-check-square-fill me-2 text-primary"></i> Hall Ticket (Admin)</li>
                </ul>
              </div>

              <button type="submit" class="btn btn-launch">
                <span style="display:inline-block; transform: skewX(-10deg);">LAUNCH</span>
              </button>
            </div>

          </div>
        </form>
      </div>
    </div>
  </div>

  <footer class="app-footer container">
    <p>CREW CHIEFS: <span class="text-white">MATLI VISHNU VARDHAN NAIDU</span> & <span class="text-white">YEMMALA LEKHA SREE</span></p>
  </footer>

  <div class="modal fade" id="cropModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="font-family: var(--font-speed); color: var(--nos-blue);">TUNE IMAGE</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center bg-black p-0 d-flex justify-content-center align-items-center" style="min-height: 400px; overflow:hidden;">
            <img id="imageToCrop" src="" alt="Picture to crop" style="max-width: 100%; max-height: 60vh; display: block;">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">CANCEL</button>
          <button type="button" class="btn btn-search btn-sm" id="cropImageBtn" style="transform: none;">APPLY</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

  <script>
    // --- 1. STUDENT FETCH LOGIC ---
    const fetchForm = document.getElementById("fetchForm");
    const rollFetch = document.getElementById("roll_number_fetch");
    const dobFetch = document.getElementById("dob_fetch");

    fetchForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = fetchForm.querySelector("button[type='submit']");
      const originalHTML = btn.innerHTML;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>SCANNING...';
      btn.disabled = true;

      const roll = rollFetch.value.trim();
      const dob = dobFetch.value;

      if (!roll || !dob) {
        alert("INPUT REQUIRED");
        btn.innerHTML = originalHTML;
        btn.disabled = false;
        return;
      }

      try {
        const res = await fetch("/api/get-student", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ roll_number: roll, dob })
        });

        const data = await res.json();
        if (!res.ok) {
          alert(data.error || "NO RECORD");
        } else {
          // Fill fields
          ['roll_number', 'name', 'father_name', 'dob', 'department', 'year', 'semester', 'section', 'mobile', 'gender', 'regulation'].forEach(id => {
             if(document.getElementById(id)) document.getElementById(id).value = data[id] || "";
          });

          if (data.photo_base64) {
            document.getElementById("photoPreview").src = data.photo_base64;
            document.getElementById("photoPreview").style.display = 'block';
            document.getElementById("emptyIcon").style.display = 'none';
          }
          
          document.getElementById("hallForm").scrollIntoView({ behavior: 'smooth' });
        }
      } catch (err) {
        console.error(err);
        alert("CONNECTION DROPPED");
      } finally {
        btn.innerHTML = originalHTML;
        btn.disabled = false;
      }
    });

    // --- 2. CURRICULUM SYNC LOGIC ---
    const loadSubjectsBtn = document.getElementById("loadSubjectsBtn");
    const subjectsContainer = document.getElementById("subjectsContainer");

    loadSubjectsBtn.addEventListener("click", async () => {
      const dept = document.getElementById("department").value;
      const year = document.getElementById("year").value;
      const sem = document.getElementById("semester").value;
      const reg = document.getElementById("regulation").value;
      const examType = document.getElementById("exam_type").value;
      const roll = document.getElementById("roll_number").value;

      if (!dept || !year || !sem || !reg) {
        alert("SPECS INCOMPLETE");
        return;
      }

      subjectsContainer.innerHTML = `<div class="text-center py-4 text-info font-monospace"><span class="spinner-border spinner-border-sm me-2"></span>SYNCING MAP...</div>`;

      try {
        const url = `/api/subjects?department=${encodeURIComponent(dept)}&year=${encodeURIComponent(year)}&semester=${encodeURIComponent(sem)}&regulation=${encodeURIComponent(reg)}&exam_type=${encodeURIComponent(examType)}&roll_number=${encodeURIComponent(roll)}`;
        const res = await fetch(url);
        const subs = await res.json();

        if (!Array.isArray(subs) || subs.length === 0) {
          subjectsContainer.innerHTML = `<div class="text-center text-muted small font-monospace">NO DATA</div>`;
          return;
        }

        let html = '<div class="row g-2">';
        subs.forEach((s) => {
          const value = `${s.subject_code}||${s.subject_name}`;
          html += `
            <div class="col-md-6">
              <div class="subject-check d-flex align-items-center">
                <input class="form-check-input mt-0 me-3 bg-dark border-secondary" type="checkbox" name="subjects" value="${value}" id="sub_${s.id}" checked>
                <label class="form-check-label lh-sm w-100" for="sub_${s.id}" style="cursor: pointer;">
                  <span class="d-block text-white fw-bold mb-1 font-monospace" style="color: var(--nos-blue) !important;">${s.subject_code}</span>
                  <span class="text-secondary small d-block">${s.subject_name}</span>
                </label>
              </div>
            </div>`;
        });
        html += '</div>';
        subjectsContainer.innerHTML = html;

      } catch (err) {
        console.error(err);
        subjectsContainer.innerHTML = `<div class="text-danger text-center small font-monospace">SYNC FAILED</div>`;
      }
    });

    // --- 3. PHOTO CROP LOGIC ---
    const photoInput = document.getElementById('photoInput');
    const imageToCrop = document.getElementById('imageToCrop');
    const cropModalEl = document.getElementById('cropModal');
    const cropModal = new bootstrap.Modal(cropModalEl);
    let cropper;

    photoInput.addEventListener('change', function (e) {
      const files = e.target.files;
      if (files && files.length > 0) {
        const file = files[0];
        const reader = new FileReader();
        reader.onload = function (e) {
          photoInput.value = ''; 
          imageToCrop.src = reader.result;
          cropModal.show();
        };
        reader.readAsDataURL(file);
      }
    });

    cropModalEl.addEventListener('shown.bs.modal', function () {
      cropper = new Cropper(imageToCrop, {
        aspectRatio: 3 / 4,
        viewMode: 1,
        autoCropArea: 1,
        background: false,
      });
    });

    cropModalEl.addEventListener('hidden.bs.modal', function () {
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
    });

    document.getElementById('cropImageBtn').addEventListener('click', function () {
      if (!cropper) return;
      
      const canvas = cropper.getCroppedCanvas({ width: 300, height: 400 });
      
      canvas.toBlob(function (blob) {
        const newFile = new File([blob], "cropped.jpg", { type: "image/jpeg" });
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(newFile);
        photoInput.files = dataTransfer.files;

        const previewUrl = URL.createObjectURL(blob);
        document.getElementById("photoPreview").src = previewUrl;
        document.getElementById("photoPreview").style.display = 'block';
        document.getElementById("emptyIcon").style.display = 'none';
        
        cropModal.hide();
      }, 'image/jpeg');
    });

  </script>
</body>
</html>