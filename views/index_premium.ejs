<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MITS | Examination Portal</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">

  <style>
    :root {
      /* Theme: Titanium & Onyx */
      --onyx-base: #02040a;
      --onyx-card: #0b0f19;
      
      /* Materials */
      --glass-heavy: rgba(11, 15, 25, 0.7);
      --glass-border: rgba(255, 255, 255, 0.08);
      --glass-shine: rgba(255, 255, 255, 0.03);
      
      /* High Voltage Accents */
      --neon-cyan: #00f0ff;
      --neon-purple: #bc13fe;
      --titanium: #e2e8f0;
      
      /* Tech Specs */
      --radius-tech: 4px; /* Sharper corners for heavy feel */
      --font-display: 'Rajdhani', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    /* --- GLOBAL ATMOSPHERE --- */
    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--onyx-base);
      color: var(--titanium);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      position: relative;
    }

    /* Heavy Grain Texture Overlay */
    body::before {
      content: "";
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
    }

    /* Cyber Grid Background */
    .grid-bg {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background-image: 
        linear-gradient(rgba(0, 240, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 240, 255, 0.03) 1px, transparent 1px);
      background-size: 50px 50px;
      z-index: -1;
      mask-image: radial-gradient(circle at center, black 40%, transparent 90%);
      -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 90%);
    }

    .main-container {
      max-width: 1200px;
      margin: 0 auto;
      flex: 1;
      padding: 4rem 1.5rem;
      position: relative;
      z-index: 2;
    }

    /* --- HEAVY TECH CARD --- */
    .tech-card {
      background: var(--glass-heavy);
      backdrop-filter: blur(30px);
      -webkit-backdrop-filter: blur(30px);
      border: 1px solid var(--glass-border);
      position: relative;
      margin-bottom: 3rem;
      box-shadow: 0 0 0 1px rgba(0,0,0,0.5), 0 20px 50px rgba(0,0,0,0.7);
      overflow: hidden; /* Keep content inside */
    }

    /* HUD Corner Brackets (The "Heavy" look) */
    .tech-card::before, .tech-card::after {
      content: '';
      position: absolute;
      width: 20px; height: 20px;
      border: 2px solid var(--neon-cyan);
      transition: all 0.3s ease;
      z-index: 5;
    }
    .tech-card::before { top: 0; left: 0; border-right: none; border-bottom: none; }
    .tech-card::after { bottom: 0; right: 0; border-left: none; border-top: none; }
    
    .tech-card:hover::before, .tech-card:hover::after {
      width: 100%; height: 100%;
      opacity: 0.1;
      border-color: var(--neon-purple);
    }

    .card-header-tech {
      padding: 1.5rem 2rem;
      background: linear-gradient(90deg, rgba(0,240,255,0.05) 0%, transparent 100%);
      border-bottom: 1px solid var(--glass-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .tech-title {
      font-family: var(--font-display);
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 2px;
      font-size: 1.1rem;
      color: var(--neon-cyan);
      text-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
    }

    .tech-number {
      font-family: var(--font-mono);
      font-size: 3rem;
      font-weight: 700;
      color: rgba(255,255,255,0.03);
      line-height: 0;
      position: relative;
      top: 5px;
    }

    .card-body-tech { padding: 3rem; }

    /* --- RECESSED INPUTS --- */
    .form-label {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 0.7rem;
    }

    .form-control, .form-select {
      background: #05080f !important; /* Very dark */
      border: 1px solid #1e293b !important;
      border-left: 2px solid #1e293b !important;
      color: #fff !important;
      border-radius: 2px; /* Brutalist/Tech radius */
      padding: 16px;
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.5); /* Recessed look */
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .form-control:focus, .form-select:focus {
      border-color: #334155 !important;
      border-left-color: var(--neon-cyan) !important;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.8), 0 0 15px rgba(0, 240, 255, 0.1) !important;
      background: #020305 !important;
    }

    /* Readonly inputs look like displays */
    input[readonly] {
      background: rgba(255, 255, 255, 0.02) !important;
      border: 1px dashed #334155 !important;
      color: #94a3b8 !important;
      cursor: not-allowed;
    }

    .form-select option { background-color: #0b0f19; }

    /* --- HEAVY INDUSTRY BUTTONS --- */
    .btn-cyber {
      background: transparent;
      border: 1px solid var(--neon-cyan);
      color: var(--neon-cyan);
      font-family: var(--font-display);
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 2px;
      padding: 14px 28px;
      position: relative;
      overflow: hidden;
      transition: 0.3s;
    }
    
    .btn-cyber::before {
      content: '';
      position: absolute;
      top: 0; left: -100%; width: 100%; height: 100%;
      background: var(--neon-cyan);
      transition: 0.3s;
      z-index: -1;
    }
    
    .btn-cyber:hover {
      color: #000;
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.4);
    }
    .btn-cyber:hover::before { left: 0; }

    .btn-main-action {
      width: 100%;
      background: linear-gradient(90deg, var(--neon-cyan), var(--neon-purple));
      border: none;
      padding: 22px;
      color: #fff;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.1rem;
      text-transform: uppercase;
      letter-spacing: 3px;
      clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
      transition: all 0.3s;
      margin-top: 1rem;
      text-shadow: 0 1px 3px rgba(0,0,0,0.5);
    }
    
    .btn-main-action:hover {
      transform: translateY(-2px);
      filter: brightness(1.2);
      box-shadow: 0 10px 40px rgba(188, 19, 254, 0.4);
    }

    /* --- HEADER --- */
    .app-header {
      text-align: center;
      margin-bottom: 3rem;
      position: relative;
    }

    .logo-glow {
      filter: drop-shadow(0 0 15px rgba(255,255,255,0.2));
    }

    .univ-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 2.2rem;
      line-height: 1;
      text-transform: uppercase;
      background: linear-gradient(to bottom, #fff, #94a3b8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-top: 10px;
      letter-spacing: 1px;
    }
    
    .subtitle-bar {
      display: inline-block;
      margin-top: 5px;
      padding: 5px 20px;
      background: rgba(0, 240, 255, 0.1);
      border: 1px solid rgba(0, 240, 255, 0.3);
      color: var(--neon-cyan);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    /* --- PHOTO ZONE --- */
    .photo-frame {
      border: 2px solid #334155;
      background: rgba(0,0,0,0.5);
      padding: 10px;
      position: relative;
    }
    
    .photo-frame::after {
      content: 'NO SIGNAL';
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: #334155;
      z-index: 0;
    }
    
    #photoPreview {
      position: relative;
      z-index: 1;
      background: transparent;
    }

    /* Checkerboard Grid for Transparency */
    .transparency-grid {
      background-color: #0f172a;
      background-image: 
        linear-gradient(45deg, #1e293b 25%, transparent 25%), 
        linear-gradient(-45deg, #1e293b 25%, transparent 25%), 
        linear-gradient(45deg, transparent 75%, #1e293b 75%), 
        linear-gradient(-45deg, transparent 75%, #1e293b 75%);
      background-size: 20px 20px;
      background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
      min-height: 180px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* --- CURRICULUM GRID --- */
    .subject-grid-item {
      background: rgba(255,255,255,0.02);
      border: 1px solid #1e293b;
      padding: 15px;
      transition: all 0.2s;
    }
    .subject-grid-item:hover {
      background: rgba(0, 240, 255, 0.05);
      border-color: var(--neon-cyan);
    }
    
    .subject-code {
      font-family: var(--font-mono);
      color: var(--neon-cyan);
      font-weight: 700;
    }

    /* Sections Dividers */
    .section-header {
      color: #fff;
      font-family: var(--font-display);
      font-size: 1rem;
      letter-spacing: 2px;
      border-bottom: 2px solid #1e293b;
      padding-bottom: 10px;
      margin-bottom: 25px;
      display: flex;
      align-items: center;
    }
    .section-header i { color: var(--neon-purple); margin-right: 10px; }

    /* Footer */
    .app-footer {
      border-top: 1px solid #1e293b;
      padding-top: 2rem;
      margin-top: 4rem;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: #475569;
    }
    .app-footer span { color: var(--neon-cyan); }

    /* Modal */
    .modal-content {
      background: #02040a;
      border: 1px solid #334155;
      color: #fff;
    }
    .modal-header, .modal-footer { border-color: #1e293b; }
    .btn-close { filter: invert(1); }

  </style>
</head>

<body>

  <div class="grid-bg"></div>

  <header class="app-header">
    <div class="container">
      <img src="https://www.facultyplus.com/wp-content/uploads/2024/12/MITS-Logo.png" alt="Logo" height="70" class="logo-glow">
      <h1 class="univ-title">MITS Examination Portal</h1>
      <div class="subtitle-bar">Secure Access Terminal // V.4.0</div>
    </div>
  </header>

  <div class="container main-container">

    <div class="tech-card">
      <div class="card-header-tech">
        <span class="tech-title">01 // Identity Verification</span>
        <span class="tech-number">ID</span>
      </div>
      <div class="card-body-tech">
        <form id="fetchForm" class="row g-4 align-items-end">
          <div class="col-md-5">
            <label class="form-label">Student ID / Roll No</label>
            <input type="text" class="form-control" id="roll_number_fetch" placeholder="ACCESS ID (e.g. 24695A4006)" required style="text-transform: uppercase; font-family: 'JetBrains Mono';">
          </div>
          <div class="col-md-5">
            <label class="form-label">Date of Birth</label>
            <input type="date" class="form-control" id="dob_fetch" required>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-cyber w-100">
              Locate
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="tech-card">
      <div class="card-header-tech">
        <span class="tech-title">02 // Hall Ticket Configuration</span>
        <span class="tech-number">CFG</span>
      </div>
      <div class="card-body-tech">

        <form id="hallForm" action="/generate-halltkt" method="POST" enctype="multipart/form-data" target="_blank">
          <div class="row g-5">

            <div class="col-lg-8">
              
              <div class="section-header">
                <i class="bi bi-person-badge"></i> CANDIDATE PROFILE
              </div>
              
              <div class="row g-3 mb-5">
                <div class="col-md-6">
                  <label class="form-label">Roll Number</label>
                  <input type="text" name="roll_number" id="roll_number" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Full Name</label>
                  <input type="text" name="name" id="name" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Guardian Name</label>
                  <input type="text" name="father_name" id="father_name" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Date of Birth</label>
                  <input type="date" name="dob" id="dob" class="form-control" readonly>
                </div>
              </div>

              <div class="section-header">
                <i class="bi bi-grid-3x3"></i> ACADEMIC PARAMETERS
              </div>

              <div class="row g-3 mb-5">
                <div class="col-md-4">
                  <label class="form-label">Mode</label>
                  <select name="mode" id="mode" class="form-select" required>
                    <option value="">SELECT MODE</option>
                    <option value="Autonomous">Autonomous</option>
                    <option value="University">University</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Department</label>
                  <select name="department" id="department" class="form-select">
                    <option value="">SELECT DEPT</option>
                    <option value="Networks">Networks</option>
                    <option value="AI & ML">AI & ML</option>
                    <option value="AI">AI</option>
                    <option value="Data Science">Data Science</option>
                    <option value="Cyber Security">Cyber Security</option>
                    <option value="Civil">Civil</option>
                    <option value="EEE">EEE</option>
                    <option value="ECE">ECE</option>
                    <option value="Mechanical">Mechanical</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Regulation</label>
                  <select name="regulation" id="regulation" class="form-select" required>
                    <option value="">SELECT REG</option>
                    <option value="R23">R23</option>
                    <option value="R20">R20</option>
                    <option value="R19">R19</option>
                    <option value="R18">R18</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Year</label>
                  <select name="year" id="year" class="form-select" required>
                    <option value="">SELECT YEAR</option>
                    <option value="1">I Year</option>
                    <option value="2">II Year</option>
                    <option value="3">III Year</option>
                    <option value="4">IV Year</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Semester</label>
                  <select name="semester" id="semester" class="form-select" required>
                    <option value="">SELECT SEM</option>
                    <option value="I-I">I-I</option>
                    <option value="I-II">I-II</option>
                    <option value="II-I">II-I</option>
                    <option value="II-II">II-II</option>
                    <option value="III-I">III-I</option>
                    <option value="III-II">III-II</option>
                    <option value="IV-I">IV-I</option>
                    <option value="IV-II">IV-II</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Section</label>
                  <input type="text" name="section" id="section" class="form-control" placeholder="SEC">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Mobile</label>
                  <input type="text" name="mobile" id="mobile" class="form-control">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Gender</label>
                  <select name="gender" id="gender" class="form-select">
                    <option value="">SELECT...</option>
                    <option>Male</option>
                    <option>Female</option>
                    <option>Other</option>
                  </select>
                </div>
              </div>

              <div class="p-4 mb-5" style="background: rgba(188, 19, 254, 0.05); border: 1px solid rgba(188, 19, 254, 0.2); border-radius: 4px;">
                 <div class="row g-3">
                    <div class="col-md-4">
                      <label class="form-label text-white">Exam Type</label>
                      <select name="exam_type" id="exam_type" class="form-select" required>
                        <option value="Regular">Regular</option>
                        <option value="Supplementary">Supplementary</option>
                      </select>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label text-white">Month</label>
                      <select name="exam_month" id="exam_month" class="form-select" required>
                        <option value="">SELECT</option>
                        <option>January</option>
                        <option>February</option>
                        <option>March</option>
                        <option>April</option>
                        <option>May</option>
                        <option>June</option>
                        <option>July</option>
                        <option>August</option>
                        <option>September</option>
                        <option>October</option>
                        <option>November</option>
                        <option>December</option>
                      </select>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label text-white">Year</label>
                      <select name="exam_year" id="exam_year" class="form-select" required>
                        <option value="">SELECT</option>
                        <option>2025</option>
                        <option>2026</option>
                        <option>2027</option>
                      </select>
                    </div>
                 </div>
              </div>

              <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-dark pb-2">
                 <h6 class="text-white mb-0 font-monospace">:: COURSE_DB ::</h6>
                <button type="button" id="loadSubjectsBtn" class="btn btn-sm btn-outline-secondary rounded-0" style="color: #fff; border-color: #334155;">
                  <i class="bi bi-arrow-repeat"></i> RELOAD
                </button>
              </div>

              <div id="subjectsContainer" class="p-3" style="background: #020305; min-height: 100px; border: 1px solid #1e293b;">
                <div class="text-center text-secondary small py-4 font-monospace">
                  > AWAITING PARAMETERS...
                </div>
              </div>
            </div>

            <div class="col-lg-4">
              <div class="section-header">
                <i class="bi bi-camera"></i> BIOMETRICS
              </div>

              <div class="photo-frame mb-4">
                <div class="transparency-grid">
                   <img id="photoPreview" class="img-fluid" style="max-height: 200px;">
                </div>
              </div>

              <label class="form-label">UPLOAD SOURCE</label>
              <input type="file" name="photo" id="photoInput" class="form-control form-control-sm mb-4" accept="image/*">

              <div class="p-4 mb-4" style="background: rgba(255,255,255,0.03); border: 1px solid #334155;">
                <h6 class="fw-bold mb-3 text-white font-monospace" style="font-size: 0.8rem;">OUTPUT MANIFEST</h6>
                <ul class="list-unstyled small mb-0 font-monospace" style="color: #94a3b8;">
                  <li class="mb-2 text-success">[+] APP_FORM.PDF</li>
                  <li class="mb-2 text-success">[+] HALL_TICKET_STUDENT</li>
                  <li class="text-success">[+] HALL_TICKET_OFFICE</li>
                </ul>
              </div>

              <button type="submit" class="btn btn-main-action">
                EXECUTE GENERATION
              </button>
            </div>

          </div>
        </form>
      </div>
    </div>
  </div>

  <footer class="app-footer container">
    <p>SYSTEM ARCHITECTS: <span class="fw-bold">Matli Vishnu Vardhan Naidu</span> (NETWORKS) & <span class="fw-bold">Yemmala Lekha Sree</span> (AI/ML)</p>
    <p style="opacity: 0.5">SECURE CONNECTION ESTABLISHED</p>
  </footer>

  <div class="modal fade" id="cropModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title font-monospace">IMAGE PROCESSING UNIT</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center bg-black p-0 d-flex justify-content-center align-items-center" style="min-height: 400px; overflow:hidden;">
            <img id="imageToCrop" src="" alt="Picture to crop" style="max-width: 100%; max-height: 60vh; display: block;">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">ABORT</button>
          <button type="button" class="btn btn-cyber btn-sm" id="cropImageBtn">CONFIRM CROP</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

  <script>
    // --- 1. STUDENT FETCH LOGIC ---
    const fetchForm = document.getElementById("fetchForm");
    const rollFetch = document.getElementById("roll_number_fetch");
    const dobFetch = document.getElementById("dob_fetch");

    fetchForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = fetchForm.querySelector("button[type='submit']");
      const originalHTML = btn.innerHTML;
      btn.innerHTML = 'QUERYING...';
      btn.disabled = true;

      const roll = rollFetch.value.trim();
      const dob = dobFetch.value;

      if (!roll || !dob) {
        alert("INPUT REQUIRED");
        btn.innerHTML = originalHTML;
        btn.disabled = false;
        return;
      }

      try {
        const res = await fetch("/api/get-student", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ roll_number: roll, dob })
        });

        const data = await res.json();
        if (!res.ok) {
          alert(data.error || "RECORD NOT FOUND");
        } else {
          // Fill fields
          ['roll_number', 'name', 'father_name', 'dob', 'department', 'year', 'semester', 'section', 'mobile', 'gender', 'regulation'].forEach(id => {
             if(document.getElementById(id)) document.getElementById(id).value = data[id] || "";
          });

          if (data.photo_base64) {
            document.getElementById("photoPreview").src = data.photo_base64;
          }
          
          document.getElementById("hallForm").scrollIntoView({ behavior: 'smooth' });
        }
      } catch (err) {
        console.error(err);
        alert("CONNECTION ERROR");
      } finally {
        btn.innerHTML = originalHTML;
        btn.disabled = false;
      }
    });

    // --- 2. CURRICULUM SYNC LOGIC ---
    const loadSubjectsBtn = document.getElementById("loadSubjectsBtn");
    const subjectsContainer = document.getElementById("subjectsContainer");

    loadSubjectsBtn.addEventListener("click", async () => {
      const dept = document.getElementById("department").value;
      const year = document.getElementById("year").value;
      const sem = document.getElementById("semester").value;
      const reg = document.getElementById("regulation").value;
      const examType = document.getElementById("exam_type").value;
      const roll = document.getElementById("roll_number").value;

      if (!dept || !year || !sem || !reg) {
        alert("MISSING PARAMETERS");
        return;
      }

      subjectsContainer.innerHTML = `<div class="text-center py-4 text-info font-monospace">SYNCING DATABASE...</div>`;

      try {
        const url = `/api/subjects?department=${encodeURIComponent(dept)}&year=${encodeURIComponent(year)}&semester=${encodeURIComponent(sem)}&regulation=${encodeURIComponent(reg)}&exam_type=${encodeURIComponent(examType)}&roll_number=${encodeURIComponent(roll)}`;
        const res = await fetch(url);
        const subs = await res.json();

        if (!Array.isArray(subs) || subs.length === 0) {
          subjectsContainer.innerHTML = `<div class="text-center text-muted small font-monospace">NO DATA FOUND</div>`;
          return;
        }

        let html = '<div class="row g-2">';
        subs.forEach((s) => {
          const value = `${s.subject_code}||${s.subject_name}`;
          html += `
            <div class="col-md-6">
              <div class="subject-grid-item d-flex align-items-center">
                <input class="form-check-input mt-0 me-3 bg-dark border-secondary" type="checkbox" name="subjects" value="${value}" id="sub_${s.id}" checked>
                <label class="form-check-label lh-sm w-100" for="sub_${s.id}" style="cursor: pointer;">
                  <span class="d-block subject-code mb-1">${s.subject_code}</span>
                  <span class="text-secondary small d-block">${s.subject_name}</span>
                </label>
              </div>
            </div>`;
        });
        html += '</div>';
        subjectsContainer.innerHTML = html;

      } catch (err) {
        console.error(err);
        subjectsContainer.innerHTML = `<div class="text-danger text-center small font-monospace">SYNC FAILED</div>`;
      }
    });

    // --- 3. PHOTO CROP LOGIC ---
    const photoInput = document.getElementById('photoInput');
    const imageToCrop = document.getElementById('imageToCrop');
    const cropModalEl = document.getElementById('cropModal');
    const cropModal = new bootstrap.Modal(cropModalEl);
    let cropper;

    photoInput.addEventListener('change', function (e) {
      const files = e.target.files;
      if (files && files.length > 0) {
        const file = files[0];
        const reader = new FileReader();
        reader.onload = function (e) {
          photoInput.value = ''; 
          imageToCrop.src = reader.result;
          cropModal.show();
        };
        reader.readAsDataURL(file);
      }
    });

    cropModalEl.addEventListener('shown.bs.modal', function () {
      cropper = new Cropper(imageToCrop, {
        aspectRatio: 3 / 4,
        viewMode: 1,
        autoCropArea: 1,
        background: false,
      });
    });

    cropModalEl.addEventListener('hidden.bs.modal', function () {
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
    });

    document.getElementById('cropImageBtn').addEventListener('click', function () {
      if (!cropper) return;
      
      const canvas = cropper.getCroppedCanvas({ width: 300, height: 400 });
      
      canvas.toBlob(function (blob) {
        const newFile = new File([blob], "cropped.jpg", { type: "image/jpeg" });
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(newFile);
        photoInput.files = dataTransfer.files;

        const previewUrl = URL.createObjectURL(blob);
        document.getElementById("photoPreview").src = previewUrl;
        
        cropModal.hide();
      }, 'image/jpeg');
    });

  </script>
</body>
</html>