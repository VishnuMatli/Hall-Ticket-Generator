<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MITS | Student Portal</title>
  
  <!-- Font: Outfit (Modern, Geometric, Friendly) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Cropper.js -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">

  <style>
    :root {
      /* Palette: Fresh Ocean & Mint */
      --primary-gradient: linear-gradient(135deg, #0ea5e9 0%, #2dd4bf 100%);
      --accent-color: #0284c7;
      --bg-color: #f0f9ff;
      --card-bg: rgba(255, 255, 255, 0.85);
      --glass-border: rgba(255, 255, 255, 0.9);
      --text-dark: #0f172a;
      --text-light: #64748b;
      
      --radius-xl: 24px;
      --radius-md: 12px;
      --shadow-soft: 0 20px 40px -5px rgba(14, 165, 233, 0.1);
      --shadow-hover: 0 25px 50px -12px rgba(14, 165, 233, 0.25);
    }

    body {
      font-family: 'Outfit', sans-serif;
      background-color: var(--bg-color);
      /* Subtle Aurora Background */
      background-image: 
        radial-gradient(at 0% 0%, rgba(56, 189, 248, 0.15) 0px, transparent 50%),
        radial-gradient(at 100% 0%, rgba(45, 212, 191, 0.15) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(168, 85, 247, 0.1) 0px, transparent 50%),
        radial-gradient(at 0% 100%, rgba(56, 189, 248, 0.15) 0px, transparent 50%);
      background-attachment: fixed;
      color: var(--text-dark);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding-bottom: 50px;
    }

    .main-container {
      max-width: 1100px;
      margin: 0 auto;
      flex: 1;
      width: 100%;
      padding-top: 2rem;
    }

    /* --- HEADER --- */
    .app-header {
      text-align: center;
      margin-bottom: 3rem;
      position: relative;
    }

    .logo-container {
      background: #fff;
      width: 80px;
      height: 80px;
      border-radius: 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-soft);
      margin-bottom: 1rem;
      transform: rotate(-3deg);
      transition: transform 0.3s;
    }
    
    .logo-container:hover {
        transform: rotate(0deg) scale(1.05);
    }

    .logo-img {
      width: 60px;
      height: 60px;
      object-fit: contain;
    }

    .brand-title {
      font-weight: 700;
      letter-spacing: -0.5px;
      background: linear-gradient(to right, #0f172a, #334155);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .badge-pill {
      background: rgba(14, 165, 233, 0.1);
      color: var(--accent-color);
      padding: 5px 15px;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 1px;
      display: inline-block;
      margin-top: 0.5rem;
    }

    /* --- CARDS --- */
    .fresh-card {
      background: var(--card-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
      padding: 0;
      box-shadow: var(--shadow-soft);
      margin-bottom: 2rem;
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .fresh-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
    }

    .card-header-fresh {
      padding: 1.5rem 2rem;
      border-bottom: 1px solid rgba(0,0,0,0.03);
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .step-dot {
      width: 32px;
      height: 32px;
      background: var(--primary-gradient);
      border-radius: 50%;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.9rem;
      box-shadow: 0 4px 10px rgba(14, 165, 233, 0.3);
    }

    .card-title {
      font-weight: 600;
      font-size: 1.1rem;
      margin: 0;
      color: var(--text-dark);
    }

    .card-body-fresh {
      padding: 2.5rem;
    }

    /* --- FORMS --- */
    .form-label {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-light);
      margin-bottom: 0.5rem;
      margin-left: 4px;
    }

    .form-control, .form-select {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: var(--radius-md);
      padding: 12px 16px;
      font-size: 0.95rem;
      transition: all 0.2s;
      box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }

    .form-control:focus, .form-select:focus {
      border-color: #38bdf8;
      box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.1);
      outline: none;
    }

    /* Readonly inputs */
    input[readonly] {
      background: #f8fafc !important;
      border-color: #f1f5f9;
      color: #64748b;
      cursor: default;
    }

    /* --- BUTTONS --- */
    .btn-gradient {
      background: var(--primary-gradient);
      border: none;
      color: white;
      padding: 12px 24px;
      border-radius: var(--radius-md);
      font-weight: 600;
      letter-spacing: 0.5px;
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }

    .btn-gradient:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(14, 165, 233, 0.3);
      color: white;
    }

    .btn-generate {
      width: 100%;
      padding: 18px;
      font-size: 1.1rem;
      border-radius: 16px;
      background: linear-gradient(135deg, #0f172a 0%, #334155 100%); /* Dark button for contrast */
    }
    
    .btn-generate:hover {
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.4);
    }

    .btn-outline-fresh {
      border: 2px solid #e2e8f0;
      color: var(--text-dark);
      background: transparent;
      border-radius: 50px;
      padding: 6px 16px;
      font-weight: 600;
      font-size: 0.85rem;
      transition: all 0.2s;
    }
    
    .btn-outline-fresh:hover {
        border-color: var(--accent-color);
        color: var(--accent-color);
        background: #f0f9ff;
    }

    /* --- SUBJECTS CHIPS --- */
    #subjectsContainer {
      background: #f8fafc;
      border-radius: 16px;
      padding: 1.5rem;
      border: 1px dashed #cbd5e1;
    }

    .subject-chip {
      background: #fff;
      border: 1px solid #e2e8f0;
      padding: 10px 15px;
      border-radius: 12px;
      margin-bottom: 10px;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      cursor: pointer;
    }

    .subject-chip:hover {
      border-color: var(--accent-color);
      transform: translateX(5px);
    }
    
    .form-check-input {
        width: 1.2em;
        height: 1.2em;
        margin-right: 12px;
        border-color: #cbd5e1;
        cursor: pointer;
    }
    
    .form-check-input:checked {
        background-color: var(--accent-color);
        border-color: var(--accent-color);
    }

    /* --- PHOTO UPLOAD --- */
    .photo-card {
      text-align: center;
      padding: 2rem;
      border-radius: var(--radius-xl);
      background: #fff;
      border: 2px dashed #e2e8f0;
      transition: all 0.2s;
    }
    
    .photo-card:hover {
        border-color: var(--accent-color);
        background: #f0f9ff;
    }

    .upload-icon-circle {
      width: 60px;
      height: 60px;
      background: #f0f9ff;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
      color: var(--accent-color);
      font-size: 1.5rem;
    }

    /* --- MODAL --- */
    .modal-content {
      border: none;
      border-radius: 20px;
      overflow: hidden;
    }
    .modal-header {
      background: #fff;
      border-bottom: 1px solid #f1f5f9;
    }
    
    /* --- FOOTER --- */
    .app-footer {
      text-align: center;
      margin-top: auto;
      font-size: 0.85rem;
      color: var(--text-light);
      opacity: 0.8;
    }
  </style>
</head>
<body>

  <header class="app-header">
    <div class="container">
      <div class="logo-container">
        <img src="https://www.facultyplus.com/wp-content/uploads/2024/12/MITS-Logo.png" alt="Logo" class="logo-img">
      </div>
      <h1 class="h3 brand-title mb-0">MITS Student Portal</h1>
      <span class="badge-pill">HALL TICKET GENERATION SYSTEM</span>
    </div>
  </header>

  <div class="container main-container">
    
    <!-- STEP 1: FETCH -->
    <div class="fresh-card">
      <div class="card-header-fresh">
        <div class="step-dot">1</div>
        <h5 class="card-title">Student Lookup</h5>
      </div>
      <div class="card-body-fresh">
        <form id="fetchForm" class="row g-4 align-items-end">
          <div class="col-md-5">
            <label class="form-label">Identity Code (Roll No)</label>
            <input type="text" class="form-control" id="roll_number_fetch" placeholder="Enter Roll Number" required>
          </div>
          <div class="col-md-5">
            <label class="form-label">Date of Birth</label>
            <input type="date" class="form-control" id="dob_fetch" required>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-gradient w-100">
              Search
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- STEP 2: DETAILS -->
    <div class="fresh-card">
      <div class="card-header-fresh">
        <div class="step-dot">2</div>
        <h5 class="card-title">Ticket Configuration</h5>
      </div>
      <div class="card-body-fresh">
        
        <form id="hallForm" action="/generate-halltkt" method="POST" enctype="multipart/form-data" target="_blank">
          <div class="row g-5">
            
            <!-- LEFT COLUMN -->
            <div class="col-lg-8">
              
              <div class="d-flex align-items-center mb-4">
                <i class="bi bi-person-lines-fill me-2 text-primary"></i>
                <h6 class="fw-bold mb-0">Student Profile</h6>
              </div>
              
              <div class="row g-3 mb-5">
                <div class="col-md-6">
                  <label class="form-label">Roll Number</label>
                  <input type="text" name="roll_number" id="roll_number" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Full Name</label>
                  <input type="text" name="name" id="name" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Guardian Name</label>
                  <input type="text" name="father_name" id="father_name" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Date of Birth</label>
                  <input type="date" name="dob" id="dob" class="form-control" readonly>
                </div>
              </div>

              <div class="d-flex align-items-center mb-4">
                <i class="bi bi-sliders me-2 text-primary"></i>
                <h6 class="fw-bold mb-0">Exam Details</h6>
              </div>
              
              <div class="row g-3 mb-4">
                <div class="col-md-4">
                  <label class="form-label">Institution Mode</label>
                  <select name="mode" id="mode" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="Autonomous">Autonomous</option>
                    <option value="University">University</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Department</label>
                  <select name="department" id="department" class="form-select">
                    <option value="">Select...</option>
                    <option value="Networks">Networks</option>
                    <option value="AI & ML">AI & ML</option>
                    <option value="AI">AI</option>
                    <option value="Data Science">Data Science</option>
                    <option value="Cyber Security">Cyber Security</option>
                    <option value="Civil">Civil</option>
                    <option value="EEE">EEE</option>
                    <option value="ECE">ECE</option>
                    <option value="Mechanical">Mechanical</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Regulation</label>
                  <select name="regulation" id="regulation" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="R23">R23</option>
                    <option value="R20">R20</option>
                    <option value="R19">R19</option>
                    <option value="R18">R18</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Year</label>
                  <select name="year" id="year" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="1">I Year</option>
                    <option value="2">II Year</option>
                    <option value="3">III Year</option>
                    <option value="4">IV Year</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Semester</label>
                  <select name="semester" id="semester" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="I-I">I-I</option>
                    <option value="I-II">I-II</option>
                    <option value="II-I">II-I</option>
                    <option value="II-II">II-II</option>
                    <option value="III-I">III-I</option>
                    <option value="III-II">III-II</option>
                    <option value="IV-I">IV-I</option>
                    <option value="IV-II">IV-II</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Section</label>
                  <input type="text" name="section" id="section" class="form-control" placeholder="A/B/C">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Mobile</label>
                  <input type="text" name="mobile" id="mobile" class="form-control">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Gender</label>
                  <select name="gender" id="gender" class="form-select">
                    <option value="">Select...</option>
                    <option>Male</option>
                    <option>Female</option>
                    <option>Other</option>
                  </select>
                </div>
              </div>

              <div class="row g-3 mb-4 p-4 rounded-4" style="background: #f0fdf4; border: 1px solid #bbf7d0;">
                 <div class="col-md-4">
                  <label class="form-label text-success">Exam Type</label>
                  <select name="exam_type" id="exam_type" class="form-select border-success" required>
                    <option value="Regular">Regular</option>
                    <option value="Supplementary">Supplementary</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label text-success">Month</label>
                  <select name="exam_month" id="exam_month" class="form-select border-success" required>
                    <option>January</option><option>February</option><option>March</option>
                    <option>April</option><option>May</option><option>June</option>
                    <option>July</option><option>August</option><option>September</option>
                    <option>October</option><option>November</option><option>December</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label text-success">Year</label>
                  <select name="exam_year" id="exam_year" class="form-select border-success" required>
                    <option>2024</option><option>2025</option><option>2026</option>
                  </select>
                </div>
              </div>

              <!-- SUBJECTS -->
              <div class="d-flex justify-content-between align-items-center mb-3">
                  <h6 class="fw-bold mb-0">Exam Subjects</h6>
                  <button type="button" id="loadSubjectsBtn" class="btn btn-outline-fresh">
                    <i class="bi bi-arrow-repeat me-1"></i> Refresh Data
                  </button>
              </div>
              
              <div id="subjectsContainer">
                <div class="text-center text-muted py-4">
                  <i class="bi bi-inbox fs-3 d-block mb-2 opacity-25"></i>
                  Select academic details to load subjects
                </div>
              </div>

            </div>

            <!-- RIGHT COLUMN -->
            <div class="col-lg-4">
              <div class="photo-card mb-4">
                <div class="upload-icon-circle">
                    <i class="bi bi-camera"></i>
                </div>
                <h6 class="fw-bold mb-3">Student Photo</h6>
                
                <div id="photoPreviewContainer" class="text-center d-none mb-3">
                  <img id="photoPreview" class="img-thumbnail border-0 shadow" style="max-width: 120px; border-radius: 12px;">
                </div>

                <input type="file" name="photo" id="photoInput" class="form-control form-control-sm mb-3" accept="image/*">
                <small class="text-muted d-block lh-sm">
                  Please upload a clear passport size photo. <br> Supports JPG/PNG.
                </small>
              </div>

              <div class="p-4 rounded-4 bg-white shadow-sm border border-light mb-4">
                <div class="d-flex">
                    <i class="bi bi-check-circle-fill text-success me-3 mt-1 fs-5"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Ready to Print?</h6>
                        <p class="small text-muted mb-0">
                            This will generate a secure PDF containing the Student Copy, Office Copy, and Application Form.
                        </p>
                    </div>
                </div>
              </div>

              <button type="submit" class="btn btn-gradient btn-generate">
                Generate Ticket <i class="bi bi-chevron-right ms-2" style="font-size: 0.9em;"></i>
              </button>
            </div>

          </div>
        </form>
      </div>
    </div>
  </div>

  <footer class="app-footer container">
      <p>Designed by <strong>Matli Vishnu Vardhan Naidu</strong> (CSE Networks)</p>
  </footer>

  <!-- Crop Modal -->
  <div class="modal fade" id="cropModal" tabindex="-1" aria-labelledby="cropModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="cropModalLabel">Crop Photo</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body bg-light text-center">
            <div style="max-height: 500px; display: inline-block;">
                <img id="imageToCrop" src="" alt="Picture to crop" style="max-width: 100%; display: block;">
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-gradient" id="cropImageBtn">Save Crop</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Cropper JS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

  <script>
    // Logic matches previous versions perfectly
    const fetchForm = document.getElementById("fetchForm");
    const rollFetch = document.getElementById("roll_number_fetch");
    const dobFetch = document.getElementById("dob_fetch");

    fetchForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = fetchForm.querySelector("button[type='submit']");
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Loading...';
      btn.disabled = true;

      const roll = rollFetch.value.trim();
      const dob = dobFetch.value;

      if (!roll || !dob) {
        alert("Please enter Roll Number and DOB");
        btn.innerHTML = originalText;
        btn.disabled = false;
        return;
      }

      try {
        const res = await fetch("/api/get-student", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ roll_number: roll, dob })
        });

        const data = await res.json();
        if (!res.ok) {
          alert(data.error || "Student not found");
        } else {
          document.getElementById("roll_number").value = data.roll_number || "";
          document.getElementById("name").value = data.name || "";
          document.getElementById("father_name").value = data.father_name || "";
          document.getElementById("dob").value = data.dob || "";
          document.getElementById("department").value = data.department || "";
          document.getElementById("year").value = data.year || "";
          document.getElementById("semester").value = data.semester || "";
          document.getElementById("section").value = data.section || "";
          document.getElementById("mobile").value = data.mobile || "";
          document.getElementById("gender").value = data.gender || "";
          document.getElementById("regulation").value = data.regulation || "";

          if (data.photo_base64) {
              document.getElementById("photoPreview").src = data.photo_base64;
              document.getElementById("photoPreviewContainer").classList.remove("d-none");
          }
          document.getElementById("hallForm").scrollIntoView({ behavior: 'smooth' });
        }
      } catch (err) {
        console.error(err);
        alert("Error fetching student details");
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    });

    const loadSubjectsBtn = document.getElementById("loadSubjectsBtn");
    const subjectsContainer = document.getElementById("subjectsContainer");

    loadSubjectsBtn.addEventListener("click", async () => {
      const dept = document.getElementById("department").value;
      const year = document.getElementById("year").value;
      const sem = document.getElementById("semester").value;
      const reg = document.getElementById("regulation").value;
      const examType = document.getElementById("exam_type").value;
      const roll = document.getElementById("roll_number").value;

      if (!dept || !year || !sem || !reg) {
        alert("Please select Department, Year, Semester, Regulation");
        return;
      }

      subjectsContainer.innerHTML = `<div class="text-center py-4"><span class="spinner-border text-primary"></span></div>`;

      try {
        const url = `/api/subjects?department=${encodeURIComponent(dept)}&year=${encodeURIComponent(year)}&semester=${encodeURIComponent(sem)}&regulation=${encodeURIComponent(reg)}&exam_type=${encodeURIComponent(examType)}&roll_number=${encodeURIComponent(roll)}`;
        const res = await fetch(url);
        const subs = await res.json();

        if (!Array.isArray(subs) || subs.length === 0) {
          subjectsContainer.innerHTML = `<div class="text-center text-muted">No subjects found.</div>`;
          return;
        }

        let html = '<div class="row g-2">';
        subs.forEach((s) => {
          const value = `${s.subject_code}||${s.subject_name}`;
          html += `
            <div class="col-md-6">
              <label class="subject-chip w-100" for="sub_${s.id}">
                <input class="form-check-input flex-shrink-0" type="checkbox" name="subjects" value="${value}" id="sub_${s.id}" checked>
                <div class="lh-sm ms-2 overflow-hidden">
                  <div class="fw-bold text-truncate text-dark small">${s.subject_code}</div>
                  <div class="text-truncate text-muted small">${s.subject_name}</div>
                </div>
              </label>
            </div>`;
        });
        html += '</div>';
        subjectsContainer.innerHTML = html;

      } catch (err) {
        console.error(err);
        subjectsContainer.innerHTML = `<div class="text-danger text-center small">Error loading subjects</div>`;
      }
    });

    // Image Cropping Logic
    const photoInput = document.getElementById('photoInput');
    const imageToCrop = document.getElementById('imageToCrop');
    const cropModalEl = document.getElementById('cropModal');
    const cropModal = new bootstrap.Modal(cropModalEl);
    let cropper;

    photoInput.addEventListener('change', function(e) {
      const files = e.target.files;
      if (files && files.length > 0) {
        const file = files[0];
        const reader = new FileReader();
        reader.onload = function(e) {
            photoInput.value = '';
            imageToCrop.src = reader.result;
            cropModal.show();
        };
        reader.readAsDataURL(file);
      }
    });

    cropModalEl.addEventListener('shown.bs.modal', function() {
      cropper = new Cropper(imageToCrop, {
        aspectRatio: 3/4,
        viewMode: 2,
        autoCropArea: 1,
      });
    });

    cropModalEl.addEventListener('hidden.bs.modal', function() {
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
    });

    document.getElementById('cropImageBtn').addEventListener('click', function() {
      if (!cropper) return;
      const canvas = cropper.getCroppedCanvas({ width: 300, height: 400 });
      canvas.toBlob(function(blob) {
        const newFile = new File([blob], "cropped.jpg", { type: "image/jpeg" });
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(newFile);
        photoInput.files = dataTransfer.files;

        const previewUrl = URL.createObjectURL(blob);
        document.getElementById("photoPreview").src = previewUrl;
        document.getElementById("photoPreviewContainer").classList.remove("d-none");
        cropModal.hide();
      }, 'image/jpeg');
    });
  </script>
</body>
</html>