<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MITS | Examination Portal</title>
  
  <!-- Fonts: Playfair Display (Serif for elegance) & Inter (Sans for utility) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Cropper.js CSS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">

  <style>
    :root {
      /* Palette - Editorial / Professional */
      --bg-body: #fafafa;
      --bg-surface: #ffffff;
      --border-color: #e2e8f0;
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      
      /* Accents */
      --brand-color: #0f172a; /* Deep Navy/Slate */
      --brand-accent: #3b82f6; /* Professional Blue */
      --input-bg: #ffffff;
      
      /* Spacing & Radius */
      --card-radius: 8px;
      --input-radius: 6px;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-body);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding-bottom: 60px;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4, h5, .serif-font {
      font-family: 'Playfair Display', serif;
    }

    .main-container {
      max-width: 1000px; /* Tighter width for reading experience */
      margin: 0 auto;
      flex: 1;
      width: 100%;
      padding-top: 2rem;
    }

    /* --- HEADER --- */
    .app-header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-color);
      padding: 2rem 0;
      margin-bottom: 2rem;
    }

    .logo-frame {
      width: 70px;
      height: 70px;
      object-fit: contain;
      transition: filter 0.3s ease;
    }
    
    .logo-frame:hover {
        filter: grayscale(0%);
    }

    .univ-title {
      font-weight: 700;
      font-size: 1.5rem;
      color: var(--brand-color);
      letter-spacing: -0.5px;
      line-height: 1.2;
    }

    .portal-tag {
      font-family: 'Inter', sans-serif;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 2px;
      font-weight: 600;
      color: var(--text-secondary);
      margin-top: 0.5rem;
      display: inline-block;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 2px;
    }

    /* --- CARDS --- */
    .clean-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--card-radius);
      padding: 0;
      margin-bottom: 2rem;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
      transition: box-shadow 0.2s ease;
    }

    .clean-card:hover {
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .card-header-clean {
      padding: 1.5rem 2rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }

    .card-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--brand-color);
      margin: 0;
    }

    .card-number {
      font-family: 'Inter', sans-serif;
      font-size: 3rem;
      font-weight: 700;
      color: #f1f5f9; /* Very subtle background number */
      line-height: 0;
      position: relative;
      top: 10px;
    }

    .card-body-clean {
      padding: 2rem;
    }

    /* --- FORMS --- */
    .form-label {
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--text-secondary);
      margin-bottom: 0.5rem;
    }

    .form-control, .form-select {
      background-color: var(--input-bg);
      border: 1px solid #cbd5e1;
      color: var(--text-primary);
      border-radius: var(--input-radius);
      padding: 10px 14px;
      font-size: 0.95rem;
      transition: all 0.2s;
      box-shadow: none;
    }

    .form-control:focus, .form-select:focus {
      border-color: var(--brand-color);
      box-shadow: 0 0 0 1px var(--brand-color); /* Clean sharp focus */
      background-color: #fff;
    }
    
    .form-control::placeholder {
        color: #94a3b8;
        font-weight: 300;
    }

    input[readonly] {
      background-color: #f8fafc !important;
      border-color: #e2e8f0;
      color: var(--text-secondary);
      font-weight: 500;
    }

    /* --- BUTTONS --- */
    .btn-action {
      background-color: var(--brand-color);
      color: white;
      border: 1px solid var(--brand-color);
      padding: 12px 24px;
      border-radius: var(--input-radius);
      font-weight: 500;
      font-size: 0.9rem;
      letter-spacing: 0.5px;
      transition: all 0.2s;
    }

    .btn-action:hover {
      background-color: #334155;
      border-color: #334155;
      transform: translateY(-1px);
    }

    .btn-outline-clean {
      background: transparent;
      border: 1px solid #cbd5e1;
      color: var(--text-primary);
      font-size: 0.8rem;
      padding: 6px 12px;
      border-radius: 4px;
      transition: all 0.2s;
    }

    .btn-outline-clean:hover {
      border-color: var(--brand-color);
      color: var(--brand-color);
    }
    
    .btn-generate {
        background-color: var(--brand-color);
        color: #fff;
        width: 100%;
        padding: 16px;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        border-radius: var(--card-radius);
        margin-top: 1rem;
    }
    
    .btn-generate:hover {
        background-color: #000;
    }

    /* --- SUBJECTS AREA --- */
    #subjectsContainer {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: var(--card-radius);
      padding: 1.5rem;
    }
    
    .subject-item {
        background: #fff;
        border: 1px solid #e2e8f0;
        padding: 10px;
        border-radius: 4px;
        margin-bottom: 8px;
    }
    
    .form-check-input:checked {
        background-color: var(--brand-color);
        border-color: var(--brand-color);
    }

    /* --- PHOTO UPLOAD --- */
    .photo-area {
      text-align: center;
      padding: 2rem;
      border: 1px dashed #cbd5e1;
      border-radius: var(--card-radius);
      background: #fafafa;
      transition: border-color 0.2s;
    }
    
    .photo-area:hover {
        border-color: var(--brand-color);
        background: #fff;
    }

    .upload-icon {
        font-size: 2rem;
        color: #94a3b8;
        margin-bottom: 1rem;
        display: block;
    }
    
    /* --- FOOTER --- */
    .app-footer {
        text-align: center;
        margin-top: auto;
        padding-top: 2rem;
        border-top: 1px solid var(--border-color);
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    /* --- MODAL --- */
    .modal-content {
        border-radius: 0;
        border: none;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }
    .modal-header {
        border-bottom: 1px solid var(--border-color);
        background: #fafafa;
    }
    
    /* --- UTILS --- */
    .divider {
        height: 1px;
        background: #e2e8f0;
        margin: 2rem 0;
    }
    
    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.1rem;
        color: var(--brand-color);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
    }
    
    .section-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #e2e8f0;
        margin-left: 1rem;
    }

  </style>
</head>
<body>

  <header class="app-header">
    <div class="container text-center">
      <div class="d-flex justify-content-center align-items-center mb-3">
        <img src="https://www.facultyplus.com/wp-content/uploads/2024/12/MITS-Logo.png" alt="Logo" class="logo-frame me-3">
        <div class="text-start">
          <h1 class="univ-title mb-0">Madanapalle Institute of<br>Technology &amp; Science</h1>
        </div>
      </div>
      <div class="portal-tag">Examination Control Division</div>
    </div>
  </header>

  <div class="container main-container">
    
    <!-- STEP 1: FETCH -->
    <div class="clean-card">
      <div class="card-header-clean">
        <h5 class="card-title">Identify Candidate</h5>
        <span class="card-number">01</span>
      </div>
      <div class="card-body-clean">
        <form id="fetchForm" class="row g-4 align-items-end">
          <div class="col-md-5">
            <label class="form-label">Student ID / Roll Number</label>
            <input type="text" class="form-control" id="roll_number_fetch" placeholder="e.g. 24695A4006" required>
          </div>
          <div class="col-md-5">
            <label class="form-label">Date of Birth</label>
            <input type="date" class="form-control" id="dob_fetch" required>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-action w-100">
              Retrieve
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- STEP 2: DETAILS -->
    <div class="clean-card">
      <div class="card-header-clean">
        <h5 class="card-title">Examination Configuration</h5>
        <span class="card-number">02</span>
      </div>
      <div class="card-body-clean">
        
        <form id="hallForm" action="/generate-halltkt" method="POST" enctype="multipart/form-data" target="_blank">
          <div class="row g-5">
            
            <!-- LEFT COLUMN -->
            <div class="col-lg-8">
              
              <div class="section-title">Candidate Profile</div>
              
              <div class="row g-3 mb-4">
                <div class="col-md-6">
                  <label class="form-label">Roll Number</label>
                  <input type="text" name="roll_number" id="roll_number" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Full Name</label>
                  <input type="text" name="name" id="name" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Guardian</label>
                  <input type="text" name="father_name" id="father_name" class="form-control" readonly>
                </div>
                <div class="col-md-6">
                  <label class="form-label">DOB</label>
                  <input type="date" name="dob" id="dob" class="form-control" readonly>
                </div>
              </div>

              <div class="section-title">Academic Parameters</div>
              
              <div class="row g-3 mb-4">
                <div class="col-md-4">
                  <label class="form-label">Mode</label>
                  <select name="mode" id="mode" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="Autonomous">Autonomous</option>
                    <option value="University">University</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Department</label>
                  <select name="department" id="department" class="form-select">
                    <option value="">Select...</option>
                    <option value="Networks">Networks</option>
                    <option value="AI & ML">AI & ML</option>
                    <option value="AI">AI</option>
                    <option value="Data Science">Data Science</option>
                    <option value="Cyber Security">Cyber Security</option>
                    <option value="Civil">Civil</option>
                    <option value="EEE">EEE</option>
                    <option value="ECE">ECE</option>
                    <option value="Mechanical">Mechanical</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Regulation</label>
                  <select name="regulation" id="regulation" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="R23">R23</option>
                    <option value="R20">R20</option>
                    <option value="R19">R19</option>
                    <option value="R18">R18</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Year</label>
                  <select name="year" id="year" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="1">I Year</option>
                    <option value="2">II Year</option>
                    <option value="3">III Year</option>
                    <option value="4">IV Year</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Semester</label>
                  <select name="semester" id="semester" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="I-I">I-I</option>
                    <option value="I-II">I-II</option>
                    <option value="II-I">II-I</option>
                    <option value="II-II">II-II</option>
                    <option value="III-I">III-I</option>
                    <option value="III-II">III-II</option>
                    <option value="IV-I">IV-I</option>
                    <option value="IV-II">IV-II</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Section</label>
                  <input type="text" name="section" id="section" class="form-control" placeholder="A/B/C">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Mobile</label>
                  <input type="text" name="mobile" id="mobile" class="form-control">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Gender</label>
                  <select name="gender" id="gender" class="form-select">
                    <option value="">Select...</option>
                    <option>Male</option>
                    <option>Female</option>
                    <option>Other</option>
                  </select>
                </div>
              </div>

              <div class="row g-3 mb-4 p-3 bg-light border rounded-3">
                 <div class="col-md-4">
                  <label class="form-label">Exam Type</label>
                  <select name="exam_type" id="exam_type" class="form-select" required>
                    <option value="Regular">Regular</option>
                    <option value="Supplementary">Supplementary</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Month</label>
                  <select name="exam_month" id="exam_month" class="form-select" required>
                    <option>January</option><option>February</option><option>March</option>
                    <option>April</option><option>May</option><option>June</option>
                    <option>July</option><option>August</option><option>September</option>
                    <option>October</option><option>November</option><option>December</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Year</label>
                  <select name="exam_year" id="exam_year" class="form-select" required>
                    <option>2024</option><option>2025</option><option>2026</option>
                  </select>
                </div>
              </div>

              <!-- SUBJECTS -->
              <div class="d-flex justify-content-between align-items-center mb-2">
                  <div class="section-title mb-0 border-0">Registered Courses</div>
                  <button type="button" id="loadSubjectsBtn" class="btn btn-outline-clean">
                    Refresh Subjects
                  </button>
              </div>
              
              <div id="subjectsContainer">
                <div class="text-center text-secondary small py-4">
                  Define academic parameters to load curriculum.
                </div>
              </div>

            </div>

            <!-- RIGHT COLUMN -->
            <div class="col-lg-4">
              <div class="photo-area mb-4">
                <i class="bi bi-person-bounding-box upload-icon"></i>
                <h6 class="fw-bold mb-3" style="font-family: 'Playfair Display', serif;">Passport Photograph</h6>
                
                <div id="photoPreviewContainer" class="text-center d-none mb-3">
                  <img id="photoPreview" class="img-thumbnail border shadow-sm" style="max-width: 140px; border-radius: 4px;">
                </div>

                <input type="file" name="photo" id="photoInput" class="form-control form-control-sm mb-2" accept="image/*">
                <div class="text-muted" style="font-size: 0.7rem; margin-top: 10px;">
                  .JPG or .PNG format required.<br>Ensure white background.
                </div>
              </div>

              <div class="bg-white border p-4 rounded-3 shadow-sm">
                <h6 class="fw-bold mb-2">Document Bundle</h6>
                <p class="text-secondary small mb-0">The system will generate a PDF containing:</p>
                <ul class="text-secondary small mt-2 ps-3 mb-0">
                    <li>Exam Application Form</li>
                    <li>Hall Ticket (Student Copy)</li>
                    <li>Hall Ticket (Office Copy)</li>
                </ul>
              </div>

              <button type="submit" class="btn btn-generate shadow">
                Generate Ticket
              </button>
            </div>

          </div>
        </form>
      </div>
    </div>
  </div>

  <footer class="app-footer container">
      <p>Developed by <strong>Matli Vishnu Vardhan Naidu</strong> &mdash; CSE (Networks) | <strong>Yemmala Lekha Sree</strong> &mdash; CSE (AI & ML)</p>
  </footer>

  <!-- Crop Modal -->
  <div class="modal fade" id="cropModal" tabindex="-1" aria-labelledby="cropModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title font-serif" id="cropModalLabel">Adjust Photograph</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body bg-light text-center">
            <div style="max-height: 500px; display: inline-block;">
                <img id="imageToCrop" src="" alt="Picture to crop" style="max-width: 100%; display: block;">
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-action" id="cropImageBtn">Apply Crop</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Cropper JS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

  <script>
    // ----- LOGIC REMAINS UNCHANGED -----
    const fetchForm = document.getElementById("fetchForm");
    const rollFetch = document.getElementById("roll_number_fetch");
    const dobFetch = document.getElementById("dob_fetch");

    fetchForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = fetchForm.querySelector("button[type='submit']");
      const originalText = btn.innerHTML;
      btn.innerHTML = 'Searching...';
      btn.disabled = true;

      const roll = rollFetch.value.trim();
      const dob = dobFetch.value;

      if (!roll || !dob) {
        alert("Please enter Roll Number and DOB");
        btn.innerHTML = originalText;
        btn.disabled = false;
        return;
      }

      try {
        const res = await fetch("/api/get-student", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ roll_number: roll, dob })
        });

        const data = await res.json();
        if (!res.ok) {
          alert(data.error || "Student not found");
        } else {
          document.getElementById("roll_number").value = data.roll_number || "";
          document.getElementById("name").value = data.name || "";
          document.getElementById("father_name").value = data.father_name || "";
          document.getElementById("dob").value = data.dob || "";
          document.getElementById("department").value = data.department || "";
          document.getElementById("year").value = data.year || "";
          document.getElementById("semester").value = data.semester || "";
          document.getElementById("section").value = data.section || "";
          document.getElementById("mobile").value = data.mobile || "";
          document.getElementById("gender").value = data.gender || "";
          document.getElementById("regulation").value = data.regulation || "";

          if (data.photo_base64) {
              document.getElementById("photoPreview").src = data.photo_base64;
              document.getElementById("photoPreviewContainer").classList.remove("d-none");
          }
          document.getElementById("hallForm").scrollIntoView({ behavior: 'smooth' });
        }
      } catch (err) {
        console.error(err);
        alert("Error fetching student details");
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    });

    const loadSubjectsBtn = document.getElementById("loadSubjectsBtn");
    const subjectsContainer = document.getElementById("subjectsContainer");

    loadSubjectsBtn.addEventListener("click", async () => {
      const dept = document.getElementById("department").value;
      const year = document.getElementById("year").value;
      const sem = document.getElementById("semester").value;
      const reg = document.getElementById("regulation").value;
      const examType = document.getElementById("exam_type").value;
      const roll = document.getElementById("roll_number").value;

      if (!dept || !year || !sem || !reg) {
        alert("Please select Department, Year, Semester, Regulation");
        return;
      }

      subjectsContainer.innerHTML = `<div class="text-center py-3 text-secondary">Loading...</div>`;

      try {
        const url = `/api/subjects?department=${encodeURIComponent(dept)}&year=${encodeURIComponent(year)}&semester=${encodeURIComponent(sem)}&regulation=${encodeURIComponent(reg)}&exam_type=${encodeURIComponent(examType)}&roll_number=${encodeURIComponent(roll)}`;
        const res = await fetch(url);
        const subs = await res.json();

        if (!Array.isArray(subs) || subs.length === 0) {
          subjectsContainer.innerHTML = `<div class="text-center text-muted small">No subjects found.</div>`;
          return;
        }

        let html = '<div class="row g-2">';
        subs.forEach((s) => {
          const value = `${s.subject_code}||${s.subject_name}`;
          html += `
            <div class="col-md-6">
              <div class="subject-item form-check d-flex align-items-center">
                <input class="form-check-input mt-0 me-2" type="checkbox" name="subjects" value="${value}" id="sub_${s.id}" checked>
                <label class="form-check-label small lh-sm" for="sub_${s.id}">
                  <span class="fw-bold d-block text-dark">${s.subject_code}</span>
                  <span class="text-secondary">${s.subject_name}</span>
                </label>
              </div>
            </div>`;
        });
        html += '</div>';
        subjectsContainer.innerHTML = html;

      } catch (err) {
        console.error(err);
        subjectsContainer.innerHTML = `<div class="text-danger text-center small">Error loading subjects</div>`;
      }
    });

    // Image Cropping Logic
    const photoInput = document.getElementById('photoInput');
    const imageToCrop = document.getElementById('imageToCrop');
    const cropModalEl = document.getElementById('cropModal');
    const cropModal = new bootstrap.Modal(cropModalEl);
    let cropper;

    photoInput.addEventListener('change', function(e) {
      const files = e.target.files;
      if (files && files.length > 0) {
        const file = files[0];
        const reader = new FileReader();
        reader.onload = function(e) {
            photoInput.value = '';
            imageToCrop.src = reader.result;
            cropModal.show();
        };
        reader.readAsDataURL(file);
      }
    });

    cropModalEl.addEventListener('shown.bs.modal', function() {
      cropper = new Cropper(imageToCrop, {
        aspectRatio: 3/4,
        viewMode: 2,
        autoCropArea: 1,
      });
    });

    cropModalEl.addEventListener('hidden.bs.modal', function() {
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
    });

    document.getElementById('cropImageBtn').addEventListener('click', function() {
      if (!cropper) return;
      const canvas = cropper.getCroppedCanvas({ width: 300, height: 400 });
      canvas.toBlob(function(blob) {
        const newFile = new File([blob], "cropped.jpg", { type: "image/jpeg" });
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(newFile);
        photoInput.files = dataTransfer.files;

        const previewUrl = URL.createObjectURL(blob);
        document.getElementById("photoPreview").src = previewUrl;
        document.getElementById("photoPreviewContainer").classList.remove("d-none");
        cropModal.hide();
      }, 'image/jpeg');
    });
  </script>
</body>
</html>